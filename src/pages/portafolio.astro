 }
];

// 5 Necesidades / Preguntas
const needs = [
 { label: 'Necesitas entender tu situación', icon: 'ion:search-outline' },
 { label: 'Quieres validar una oportunidad', icon: 'ion:bar-chart-outline' },
 { label: 'Debes responder a una exigencia', icon: 'ion:document-text-outline' },
 { label: 'Tus áreas no están alineadas', icon: 'ion:git-network-outline' },
 { label: 'Necesitas pasar a la acción', icon: 'ion:arrow-forward-circle-outline' }
];

// 4 Soluciones
const integraciones = [
 {
 title: 'Asesoría institucional integral',
 desc: 'Visión completa para decisiones de mayor alcance.',
 icon: 'ion:business-outline'
 },
 {
 title: 'Estudios para decidir',
 desc: 'Análisis técnicos que respaldan tus decisiones.',
 icon: 'ion:stats-chart-outline'
 },
 {
 title: 'Revisión de brechas y evidencias',
 desc: 'Orden, coherencia y sustento documental.',
 icon: 'ion:clipboard-outline'
 },
 {
 title: 'Acompañamiento a la implementación',
 desc: 'De la recomendación a la acción.',
 icon: 'ion:construct-outline'
 }
];

// 5 Pasos
const steps = [
 {
 num: '1',
 title: 'Escuchar',
 desc: 'Entendemos tu contexto, objetivos y desafíos.',
 icon: 'ion:ear-outline'
 },
 {
 num: '2',
 title: 'Revisar',
 desc: 'Analizamos información, documentos y evidencia.',
 icon: 'ion:document-outline'
 },
 {
 num: '3',
 title: 'Identificar',
 desc: 'Detectamos brechas, riesgos y oportunidades.',
 icon: 'ion:search-circle-outline'
 },
 {
 num: '4',
 title: 'Recomendar',
 desc: 'Proponemos una ruta técnica y viable de acción.',
 icon: 'ion:bulb-outline'
 },
 {
 num: '5',
 title: 'Acompañar',
 desc: 'Trabajamos contigo la implementación y seguimiento.',
 icon: 'ion:people-circle-outline'
 }
];

// 5 Por qué CEDEPRO
const reasons = [
 { title: 'Experiencia sectorial', icon: 'ion:school-outline' },
 { title: 'Decisiones basadas en evidencia', icon: 'ion:stats-chart-outline' },
 { title: 'Prevención antes que reproceso', icon: 'ion:shield-checkmark-outline' },
 { title: 'Conexión entre áreas', icon: 'ion:git-network-outline' },
 { title: 'Acompañamiento cercano', icon: 'ion:heart-outline' }
];

// Estadísticas
const stats = [
 { value: '+70', label: 'Carreras aprobadas' },
 { value: '+10', label: 'Institutos creados' },
 { value: '+2.500', label: 'Profesionales capacitados' },
 { value: '+30', label: 'Instituciones asesoradas' }
];
---

<Layout 
 title="Cinco años CEDEPRO | Asesoría - Decisiones claras y respaldo técnico"
 description="Cuando una decisión impacta el futuro de tu institución, el respaldo importa. Acompañamos a instituciones de educación superior a analizar información y convertir desafíos en acciones."
 image="/assets/cinco-anios/nosotros-hero.webp"
>

 <!-- =========================================================================
 1. ÁRBOL PORTAFOLIO (Organigrama)
 ========================================================================= -->
 <section class="relative py-4 sm:py-5 lg:py-6 px-2 sm:px-6 lg:px-8 bg-[#07192F] overflow-hidden flex flex-col justify-center items-center">
    
    <div class="w-full max-w-[1280px] mx-auto overflow-x-auto custom-scrollbar flex justify-center items-center py-1">
        
        <!-- Contenedor del Árbol perfectamente centrado en pantalla -->
        <div class="relative flex flex-col gap-2.5 min-w-[600px] sm:min-w-[680px] max-w-[840px] mx-auto py-1 px-2 sm:px-4">
            
            <!-- EL TRONCO PRINCIPAL (Para cambiar su altura ajusta top-[...] y bottom-[...]) -->
            <div class="absolute left-16 top-[1.25rem] bottom-[1.25rem] w-[2px] bg-[#df9417]"></div>

            <!-- 1. CEDEPRO ASESORÍA -->
            <div class="relative flex items-start group">
                <div class="absolute left-12 top-[1rem] w-3 h-[2px] bg-[#df9417]"></div>
                
                <div class="ml-[60px] w-[155px] sm:w-[180px] shrink-0 relative z-10 flex items-center">
                    <div class="bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-8 border border-[#df9417]/70 shadow-[0_0_12px_rgba(223,148,23,0.2)] flex items-center justify-center text-center w-full transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                        <span class="text-[#df9417] font-bold text-[11px] sm:text-[11.5px] uppercase tracking-wide text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO ASESORÍA</span>
                    </div>
                    <div class="absolute left-full top-[1rem] w-4 h-[2px] bg-[#df9417]"></div>
                </div>

                <div class="ml-4 flex flex-col gap-1.5 relative w-[240px] sm:w-[260px]">
                    <div class="absolute left-0 top-[0.875rem] bottom-[0.875rem] w-[2px] bg-[#df9417]"></div>
                    
                    <div class="relative flex items-center h-7">
                        <div class="absolute left-0 top-1/2 w-4 h-[2px] bg-[#df9417]"></div>
                        <div class="ml-4 bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-7 border border-[#df9417]/70 flex items-center justify-center shadow-[0_0_12px_rgba(223,148,23,0.2)] w-fit transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                            <span class="text-[#df9417] font-bold text-[10px] sm:text-[10.5px] uppercase text-center leading-none inline-flex items-center justify-center">CEDEPRO RESPALDO</span>
                        </div>
                    </div>
                    
                    <div class="relative flex items-center h-7">
                        <div class="absolute left-0 top-1/2 w-4 h-[2px] bg-[#df9417]"></div>
                        <div class="ml-4 bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-7 border border-[#df9417]/70 flex items-center justify-center shadow-[0_0_12px_rgba(223,148,23,0.2)] w-fit transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                            <span class="text-[#df9417] font-bold text-[10px] sm:text-[10.5px] uppercase text-center leading-none inline-flex items-center justify-center">CEDEPRO ACOMPAÑAMIENTO</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. CEDEPRO PROYECTOS -->
            <div class="relative flex items-start group">
                <div class="absolute left-12 top-[1rem] w-3 h-[2px] bg-[#df9417]"></div>
                
                <div class="ml-[60px] w-[155px] sm:w-[180px] shrink-0 relative z-10 flex items-center">
                    <div class="bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-8 border border-[#df9417]/70 shadow-[0_0_12px_rgba(223,148,23,0.2)] flex items-center justify-center text-center w-full transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                        <span class="text-[#df9417] font-bold text-[11px] sm:text-[11.5px] uppercase tracking-wide text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO PROYECTOS</span>
                    </div>
                    <div class="absolute left-full top-[1rem] w-4 h-[2px] bg-[#df9417]"></div>
                </div>

                <div class="ml-4 flex flex-col relative w-full max-w-[380px]">
                    <div class="absolute left-0 top-[1rem] w-4 h-[2px] bg-[#df9417]"></div>
                    <div class="ml-4 bg-white/10 backdrop-blur-md border border-white/25 cursor-pointer shadow-[0_6px_24px_0_rgba(0,0,0,0.25)] rounded-xl px-3.5 py-2 transition-all hover:bg-white/15 hover:border-white/40">
                        <ul class="space-y-1 text-white text-[11px] sm:text-[11.5px] font-medium leading-snug">
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Transformación institucional.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Calidad y regulación.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Estudios y modelos de negocio.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Innovación y transformación digital.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Proyectos especiales.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 3. CEDEPRO ACADEMIA -->
            <div class="relative flex items-start group">
                <div class="absolute left-12 top-[1rem] w-3 h-[2px] bg-[#df9417]"></div>
                
                <div class="ml-[60px] w-[155px] sm:w-[180px] shrink-0 relative z-10 flex items-center">
                    <div class="bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-8 border border-[#df9417]/70 shadow-[0_0_12px_rgba(223,148,23,0.2)] flex items-center justify-center text-center w-full transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                        <span class="text-[#df9417] font-bold text-[11px] sm:text-[11.5px] uppercase tracking-wide text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO ACADEMIA</span>
                    </div>
                    <div class="absolute left-full top-[1rem] w-4 h-[2px] bg-[#df9417]"></div>
                </div>

                <div class="ml-4 flex flex-col gap-1.5 relative w-full max-w-[480px]">
                    <div class="absolute left-0 top-[0.875rem] bottom-[0.875rem] w-[2px] bg-[#df9417]"></div>
                    
                    <!-- Row 1 -->
                    <div class="relative flex items-center h-7">
                        <div class="absolute left-0 top-1/2 w-4 h-[2px] bg-[#df9417]"></div>
                        <div class="ml-4 flex items-center gap-0 w-full">
                            <div class="bg-[#df9417]/10 backdrop-blur-md border border-[#df9417]/70 rounded-full px-3 h-7 flex items-center justify-center shrink-0 w-[130px] sm:w-[138px] shadow-[0_0_12px_rgba(223,148,23,0.2)] transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                                <span class="text-[#df9417] font-bold text-[9.5px] sm:text-[10px] text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO IMPULSA</span>
                            </div>
                            <div class="w-4 h-[2px] bg-[#df9417] shrink-0"></div>
                            <div class="bg-white/10 backdrop-blur-md border border-white/25 cursor-pointer rounded-lg px-3 h-7 flex items-center justify-center text-center shadow-[0_2px_10px_0_rgba(0,0,0,0.2)] transition-all hover:bg-white/20 hover:border-white/40">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0 mr-2"></span>
                                <span class="text-white text-[11px] sm:text-[11.5px] font-medium leading-none text-center inline-flex items-center justify-center">Capacitación en educación.</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Row 2 -->
                    <div class="relative flex items-center h-7">
                        <div class="absolute left-0 top-1/2 w-4 h-[2px] bg-[#df9417]"></div>
                        <div class="ml-4 flex items-center gap-0 w-full">
                            <div class="bg-[#df9417]/10 backdrop-blur-md border border-[#df9417]/70 rounded-full px-3 h-7 flex items-center justify-center shrink-0 w-[130px] sm:w-[138px] shadow-[0_0_12px_rgba(223,148,23,0.2)] transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                                <span class="text-[#df9417] font-bold text-[9.5px] sm:text-[10px] text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO EJECUTA</span>
                            </div>
                            <div class="w-4 h-[2px] bg-[#df9417] shrink-0"></div>
                            <div class="bg-white/10 backdrop-blur-md border border-white/25 cursor-pointer rounded-lg px-3 h-7 flex items-center justify-center text-center shadow-[0_2px_10px_0_rgba(0,0,0,0.2)] transition-all hover:bg-white/20 hover:border-white/40">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0 mr-2"></span>
                                <span class="text-white text-[11px] sm:text-[11.5px] font-medium leading-none text-center inline-flex items-center justify-center">Capacitación legal.</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Row 3 -->
                    <div class="relative flex items-center h-7">
                        <div class="absolute left-0 top-1/2 w-4 h-[2px] bg-[#df9417]"></div>
                        <div class="ml-4 flex items-center gap-0 w-full">
                            <div class="bg-[#df9417]/10 backdrop-blur-md border border-[#df9417]/70 rounded-full px-3 h-7 flex items-center justify-center shrink-0 w-[130px] sm:w-[138px] shadow-[0_0_12px_rgba(223,148,23,0.2)] transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                                <span class="text-[#df9417] font-bold text-[9.5px] sm:text-[10px] text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO GESTIONA</span>
                            </div>
                            <div class="w-4 h-[2px] bg-[#df9417] shrink-0"></div>
                            <div class="bg-white/10 backdrop-blur-md border border-white/25 cursor-pointer rounded-lg px-3 h-7 flex items-center justify-center text-center shadow-[0_2px_10px_0_rgba(0,0,0,0.2)] transition-all hover:bg-white/20 hover:border-white/40">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0 mr-2"></span>
                                <span class="text-white text-[11px] sm:text-[11.5px] font-medium leading-none text-center inline-flex items-center justify-center">Capacitación para el sector público.</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Row 4 -->
                    <div class="relative flex items-center h-7">
                        <div class="absolute left-0 top-1/2 w-4 h-[2px] bg-[#df9417]"></div>
                        <div class="ml-4 flex items-center gap-0 w-full">
                            <div class="bg-[#df9417]/10 backdrop-blur-md border border-[#df9417]/70 rounded-full px-3 h-7 flex items-center justify-center shrink-0 w-[130px] sm:w-[138px] shadow-[0_0_12px_rgba(223,148,23,0.2)] transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                                <span class="text-[#df9417] font-bold text-[9.5px] sm:text-[10px] text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO EQUILIBRA</span>
                            </div>
                            <div class="w-4 h-[2px] bg-[#df9417] shrink-0"></div>
                            <div class="bg-white/10 backdrop-blur-md border border-white/25 cursor-pointer rounded-lg px-3 h-7 flex items-center justify-center text-center shadow-[0_2px_10px_0_rgba(0,0,0,0.2)] transition-all hover:bg-white/20 hover:border-white/40">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0 mr-2"></span>
                                <span class="text-white text-[11px] sm:text-[11.5px] font-medium leading-none text-center inline-flex items-center justify-center">Capacitación en bienestar.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. CEDEPRO GESTIÓN -->
            <div class="relative flex items-start group">
                <div class="absolute left-12 top-[1rem] w-3 h-[2px] bg-[#df9417]"></div>
                
                <div class="ml-[60px] w-[155px] sm:w-[180px] shrink-0 relative z-10 flex items-center">
                    <div class="bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-8 border border-[#df9417]/70 shadow-[0_0_12px_rgba(223,148,23,0.2)] flex items-center justify-center text-center w-full transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                        <span class="text-[#df9417] font-bold text-[11px] sm:text-[11.5px] uppercase tracking-wide text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO GESTIÓN</span>
                    </div>
                    <div class="absolute left-full top-[1rem] w-4 h-[2px] bg-[#df9417]"></div>
                </div>

                <div class="ml-4 flex flex-col relative w-full max-w-[380px]">
                    <div class="absolute left-0 top-[1rem] w-4 h-[2px] bg-[#df9417]"></div>
                    <div class="ml-4 bg-white/10 backdrop-blur-md border border-white/25 cursor-pointer shadow-[0_6px_24px_0_rgba(0,0,0,0.25)] rounded-xl px-3.5 py-2 transition-all hover:bg-white/15 hover:border-white/40">
                        <ul class="space-y-1 text-white text-[11px] sm:text-[11.5px] font-medium leading-snug">
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Transformación institucional.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Oferta académica en línea.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Sedes y centros de apoyo.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Educación continua.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> CPS y unidades productivas.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> Modelos SPA y bienestar.</li>
                            <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#df9417] shrink-0"></span> PMO y gestión de unidades institucionales.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 5. CEDEPRO INTERNACIONAL -->
            <div class="relative flex items-center group">
                <div class="absolute left-12 top-[1rem] w-3 h-[2px] bg-[#df9417]"></div>
                <div class="ml-[60px] w-[155px] sm:w-[180px] shrink-0 relative z-10 flex items-center">
                    <div class="bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-8 border border-[#df9417]/70 shadow-[0_0_12px_rgba(223,148,23,0.2)] flex items-center justify-center text-center w-full transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                        <span class="text-[#df9417] font-bold text-[11px] sm:text-[11.5px] uppercase tracking-wide text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO INTERNACIONAL</span>
                    </div>
                </div>
            </div>

            <!-- 6. CEDEPRO TECH -->
            <div class="relative flex items-center group">
                <div class="absolute left-12 top-[1rem] w-3 h-[2px] bg-[#df9417]"></div>
                <div class="ml-[60px] w-[155px] sm:w-[180px] shrink-0 relative z-10 flex items-center">
                    <div class="bg-[#df9417]/10 backdrop-blur-md rounded-full px-3.5 h-8 border border-[#df9417]/70 shadow-[0_0_12px_rgba(223,148,23,0.2)] flex items-center justify-center text-center w-full transition-all duration-300 hover:bg-[#df9417]/25 hover:border-[#df9417] hover:shadow-[0_0_20px_rgba(223,148,23,0.5)] hover:scale-[1.04] hover:-translate-y-0.5 cursor-pointer">
                        <span class="text-[#df9417] font-bold text-[11px] sm:text-[11.5px] uppercase tracking-wide text-center leading-none inline-flex items-center justify-center w-full">CEDEPRO TECH</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(223, 148, 23, 0.4);
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(223, 148, 23, 0.8);
        }
    </style>
 </section>




 <!-- =========================================================================
 1. HERO HEADER SECTION (Texto a la derecha según PDF)
 ========================================================================= -->
 <section class="hero-section relative bg-[#07192F] overflow-hidden">
 
 <!-- Capa de imagen de fondo adaptable -->
 <div class="hero-bg-layer" aria-hidden="true"></div>

 <!-- Difuminado horizontal continuo para Desktop (de derecha a izquierda) -->
 <div class="hero-desktop-overlay" aria-hidden="true"></div>

 <!-- Difuminado vertical para Móviles -->
 <div class="hero-mobile-overlay" aria-hidden="true"></div>

 <div class="hero-content relative max-w-[1536px] w-full mx-auto z-10 px-4 sm:px-6 lg:pl-12 lg:pr-16 xl:pr-24 flex justify-end">
 <div class="hero-text-block space-y-3 sm:space-y-4 text-left">
 
 <p class="text-[#df9417] text-xs sm:text-sm font-normal tracking-widest uppercase italic">
 CEDEPRO ASESORÍA
 </p>

 <!-- Titular Principal -->
 <h1 class="text-white text-3xl sm:text-4xl lg:text-[2.6rem] font-bold !leading-[1.14] tracking-tight drop-shadow-sm">
