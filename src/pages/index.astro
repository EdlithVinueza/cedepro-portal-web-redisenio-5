  <style>
    /* =========================================================================
       HERO RESPONSIVE ADAPTATIVO: MÓVILES (ROSTROS VISIBLES) & DESKTOP (DIFUMINADO INMUTABLE)
       ========================================================================= */

    /* Reglas comunes de las capas del hero */
    .hero-bg-layer {
      background-repeat: no-repeat;
    }

    /* 1. MÓVILES Y PANTALLAS EN RETRATO (Teléfonos, portrait, tablet vertical) */
    @media (orientation: portrait), (max-aspect-ratio: 1/1), (max-width: 767px) {
      .hero-section {
        min-height: 760px !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start !important;
        background-color: #07192F !important;
        padding-top: 1.5rem !important;
        padding-bottom: 0 !important;
        position: relative !important;
      }

      .hero-content {
        padding-top: 1rem !important;
        padding-bottom: 1.5rem !important;
        position: relative !important;
        z-index: 10 !important;
      }

      .hero-text-block {
        max-width: 100% !important;
      }

      /* Imagen bajada a la parte inferior: ubicada debajo de los botones con rostros 100% despejados */
      .hero-bg-layer {
        display: block !important;
        position: absolute !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 380px !important;
        background-image: url('/assets/home/img-parte-1-home-hero-mobile.webp') !important;
        background-size: cover !important;
        background-position: 52% top !important;
        z-index: 1 !important;
      }

      /* Difuminado suave superior en la imagen que se fusiona con el fondo azul marino de los botones */
      .hero-mobile-overlay {
        display: block !important;
        position: absolute !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 380px !important;
        background: linear-gradient(
          180deg,
          #07192F 0%,
          rgba(7, 25, 47, 0.60) 10%,
          rgba(7, 25, 47, 0) 22%
        ) !important;
        pointer-events: none !important;
        z-index: 2 !important;
      }

      .hero-desktop-overlay {
        display: none !important;
      }
    }

    /* 2. ESCRITORIO Y LANDSCAPE (Pantallas panorámicas, monitores, laptops, ventanas redimensionadas) */
    @media (orientation: landscape) and (min-aspect-ratio: 1/1) and (min-width: 768px) {
      .hero-section {
        min-height: 560px !important;
        max-height: 820px !important;
        height: calc(100vh - 5rem) !important;
        display: flex !important;
        align-items: center !important;
        background-color: #07192F !important;
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
        position: relative !important;
      }

      .hero-bg-layer {
        display: block !important;
        position: absolute !important;
        inset: 0 !important;
        background-image: url('/assets/home/img-parte-1-home-hero.webp') !important;
        background-size: cover !important;
        background-position: right center !important;
        z-index: 1 !important;
      }

      /* DIFUMINADO INMUTABLE: Difuminado continuo de izquierda a derecha.
         En pantallas muy anchas da prioridad a las imágenes en la derecha.
         Al minimizar o reducir la ventana, NUNCA se pierde el difuminado,
         protegiendo la tipografía y garantizando una transición impecable hacia el fondo marino. */
      .hero-desktop-overlay {
        display: block !important;
        position: absolute !important;
        inset: 0 !important;
        background: linear-gradient(
          90deg,
          #07192F 0%,
          #07192F 30%,
          rgba(7, 25, 47, 0.96) 46%,
          rgba(7, 25, 47, 0.72) 60%,
          rgba(7, 25, 47, 0.18) 75%,
          rgba(7, 25, 47, 0) 88%
        ) !important;
        pointer-events: none !important;
        z-index: 2 !important;
      }

      .hero-mobile-overlay {
        display: none !important;
      }

      .hero-content {
        position: relative !important;
        z-index: 10 !important;
      }

      /* Ancho de texto balanceado según el viewport para dar siempre máxima prioridad a las imágenes */
      .hero-text-block {
        max-width: 450px !important;
      }

      @media (min-width: 1200px) {
        .hero-text-block {
          max-width: 520px !important;
        }
      }

      @media (min-width: 1440px) {
        .hero-text-block {
          max-width: 580px !important;
        }
      }

      @media (min-width: 1600px) {
        .hero-text-block {
          max-width: 620px !important;
        }
      }
    }
  </style>

