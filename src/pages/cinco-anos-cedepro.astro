---
import Layout from '../layouts/Layout.astro';

// 6 Líneas de Solución CEDEPRO
const solutions = [
  {
    prefix: 'CEDEPRO',
    name: 'Asesoría',
    description: 'Decisiones claras y respaldo técnico integral en aspectos legales, administrativos y normativos.',
    link: '/recursos#asesoria',
    icon: `<svg class="w-14 h-14 text-[#f5a623]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="20" cy="16" r="6"/><path d="M9 38c0-5.5 4.9-10 11-10s11 4.5 11 10"/><path d="M30 9h9a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4h-2.5l-3.5 4v-4H30a4 4 0 0 1-4-4v-5a4 4 0 0 1 4-4z"/><circle cx="33.5" cy="15.5" r="0.8" fill="currentColor"/><circle cx="38" cy="15.5" r="0.8" fill="currentColor"/></svg>`
  },
  {
    prefix: 'CEDEPRO',
    name: 'Formación',
    description: 'Equipos preparados para nuevos desafíos con metodologías innovadoras y programas certificados.',
    link: '/recursos#formacion',
    icon: `<svg class="w-14 h-14 text-[#f5a623]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 10 5 19l19 9 19-9-19-9z"/><path d="M12 22.5v7.5c0 3.8 5.4 7 12 7s12-3.2 12-7v-7.5"/><path d="M38 19v12"/><circle cx="38" cy="32" r="1.5" fill="currentColor"/></svg>`
  },
  {
    prefix: 'CEDEPRO',
    name: 'Gestión',
    description: 'Procesos ordenados, auditorías y resultados confiables bajo estándares de calidad ISO 9001:2015.',
    link: '/recursos#gestion',
    icon: `<svg class="w-14 h-14 text-[#f5a623]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="12" r="3.5"/><circle cx="15" cy="15" r="3"/><circle cx="33" cy="15" r="3"/><path d="M10 23.5c0-2.2 1.8-4 4-4 .8 0 1.5.2 2.2.6"/><path d="M31.8 20.1c.7-.4 1.4-.6 2.2-.6 2.2 0 4 1.8 4 4"/><path d="M19 22c1.3-1.2 3.1-2 5-2s3.7.8 5 2"/><circle cx="24" cy="34" r="4"/><path d="M24 26.5v2.5M24 39v2.5M16.5 34H19M29 34h2.5M18.7 28.7l1.8 1.8M27.5 37.5l1.8 1.8M18.7 39.3l1.8-1.8M27.5 30.5l1.8-1.8"/></svg>`
  },
  {
    prefix: 'CEDEPRO',
    name: 'Proyectos',
    description: 'Ideas estructuradas para crecer: diseño curricular, creación de unidades académicas e institutos.',
    link: '/recursos#proyectos',
    icon: `<svg class="w-14 h-14 text-[#f5a623]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 5v3M13 8l2 2M29 8l-2 2"/><path d="M21 11a9 9 0 0 0-6.8 14.8c1.3 1.5 2 3.3 2 5.2h7.6"/><path d="M18.5 34.5h5.5M19.5 37.5h3.5"/><circle cx="31.5" cy="27.5" r="5"/><path d="M35.2 31.2l4.8 4.8"/></svg>`
  },
  {
    prefix: 'CEDEPRO',
    name: 'Internacional',
    description: 'Alianzas para ampliar horizontes académicos, convenios globales y homologación internacional.',
    link: '/recursos#internacional',
    icon: `<svg class="w-14 h-14 text-[#f5a623]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="11"/><path d="M13 24h22"/><path d="M24 13c-3 3.5-4.8 7-4.8 11s1.8 7.5 4.8 11"/><path d="M24 13c3 3.5 4.8 7 4.8 11s-1.8 7.5-4.8 11"/><path d="M8 20.5C9.5 14 17 9.5 25.5 10c7.5.5 13 4.5 13.5 9.5-.5 5-5.5 8.5-12.5 9.5"/><path d="M36 15l4 4 4.5-2.5"/></svg>`
  },
  {
    prefix: 'CEDEPRO',
    name: 'Tech',
    description: 'Tecnología para transformar la educación: campus virtual, analítica institucional e inteligencia artificial.',
    link: '/recursos#tech',
    icon: `<svg class="w-14 h-14 text-[#f5a623]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="34" height="23" rx="3"/><path d="M24 32v7M18 39h12"/><circle cx="24" cy="20.5" r="3"/><path d="M24 15.5v1.5M24 24v1.5M19 20.5h1.5M27.5 20.5H29M20.5 17l1.1 1.1M26.4 22.9l1.1 1.1M20.5 24l1.1-1.1M26.4 18.1l1.1-1.1"/></svg>`
  }
];

const milestones = [
  { year: 'Año 1', title: 'Nacimiento y Propósito', desc: 'Fundación de CEDEPRO con el compromiso de transformar la consultoría técnica y legal en la educación superior ecuatoriana.' },
  { year: 'Año 2', title: 'Primeros 10 ISTT', desc: 'Acompañamiento exitoso en la creación y estructuración técnico-pedagógica de institutos superiores tecnológicos.' },
  { year: 'Año 3', title: 'Certificación ISO 9001:2015', desc: 'Estandarización y acreditación de todos los procesos de consultoría y gestión con los más altos estándares internacionales.' },
  { year: 'Año 4', title: 'Expansión Tecnológica y Académica', desc: 'Lanzamiento de metodologías ágiles de diseño curricular con más de 70 carreras y programas aprobados.' },
  { year: 'Año 5', title: 'Consolidación Nacional', desc: 'Más de 30 instituciones asesoradas, +2500 profesionales capacitados y alianzas estratégicas de primer nivel.' }
];
---

<Layout 
  title="Cinco Años CEDEPRO – 5 Años Impulsando la Educación Superior"
  description="Celebrando 5 años de trayectoria: 4 caminos, un mismo propósito. Seis líneas de solución especializadas para las instituciones educativas del Ecuador."
  image="/assets/home/cinco-anos-solo.webp"
>
  <!-- Hero Section -->
  <section class="relative bg-white pt-8 pb-14 sm:py-16 lg:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">
        
        <!-- Columna de Texto -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6 z-10 text-left">
          
          <!-- Badge 5 AÑOS • 4 caminos • Un mismo propósito -->
          <div class="inline-flex items-center gap-2.5 sm:gap-3 flex-wrap">
            <img 
              src="/assets/cinco-años/cinco-anos-azul.webp" 
              alt="5 AÑOS CEDEPRO" 
              class="h-8 sm:h-10 md:h-11 w-auto object-contain shrink-0"
              width="140"
              height="50"
              decoding="async"
              loading="eager"
            />
            <div class="flex items-center gap-1.5 sm:gap-2 text-[#091E3A] font-semibold text-xs sm:text-[13px] md:text-sm tracking-wide">
              <span class="text-[#c67a00] text-sm sm:text-base font-bold">•</span>
              <span>4 caminos</span>
              <span class="text-[#c67a00] text-sm sm:text-base font-bold">•</span>
              <span>Un mismo propósito</span>
            </div>
          </div>

          <!-- Titular Principal H1 -->
          <h1 class="text-3xl sm:text-4xl md:text-[2.65rem] lg:text-[2.85rem] xl:text-[3.2rem] font-bold text-[#091E3A] font-heading leading-[1.15] tracking-tight">
            El aliado estratégico para el crecimiento de tu institución.
          </h1>

          <!-- Párrafo Descriptivo -->
          <p class="text-slate-600 text-sm sm:text-base md:text-[15.5px] font-normal leading-relaxed max-w-xl text-balance">
            Las instituciones de educación superior enfrentan decisiones cada vez más complejas. En CEDEPRO reunimos experiencia, criterio técnico e innovación aplicada para ayudarte a tomar mejores decisiones, fortalecer tus equipos, ordenar tu gestión y convertir tus oportunidades en proyectos sostenibles.
          </p>

          <!-- Botones de Acción -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a 
              href="#nuestro-camino" 
              class="btn-gold-dark !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold shadow-md hover:shadow-lg text-center justify-center inline-flex items-center gap-2 group"
            >
              <span>Conoce nuestro camino</span>
              <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 font-bold">→</span>
            </a>

            <a 
              href="/contactanos" 
              class="btn-outline-gold-navy !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold text-center justify-center inline-flex items-center"
            >
              <span>Solicita una asesoría</span>
            </a>
          </div>

        </div>

        <!-- Columna de Imagen: img-1-nosotros -->
        <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
          <picture>
            <source srcset="/assets/cinco-años/img-1-nosotros.webp" type="image/webp" />
            <img 
              src="/assets/cinco-años/img-1-nosotros.png" 
              alt="Equipo CEDEPRO analizando proyectos de educación superior" 
              class="w-full max-w-lg lg:max-w-none h-auto object-contain drop-shadow-sm"
              width="1813"
              height="1366"
              decoding="async"
              loading="eager"
            />
          </picture>
        </div>

      </div>
    </div>
  </section>

  <!-- Hitos de los 5 Años (Timeline) -->
  <section id="nuestro-camino" class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto space-y-12">
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <p class="text-[#c67a00] text-xs sm:text-sm font-bold tracking-widest uppercase">
          NUESTRO CAMINO
        </p>
        <h2 class="text-2xl sm:text-4xl font-bold text-[#091E3A] font-heading">
          5 Años construyendo excelencia paso a paso
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {milestones.map((m) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <span class="inline-block px-3 py-1 bg-[#c67a00]/10 text-[#c67a00] font-bold text-xs rounded-full mb-3">
                {m.year}
              </span>
              <h3 class="text-base font-bold text-[#091E3A] mb-2 font-heading">
                {m.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {m.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 Líneas de Solución -->
  <section id="lineas" class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-cover bg-center overflow-hidden" style="background-image: url('/assets/home/img-parte-2-home.webp');">
    <div class="absolute inset-0 bg-white/60 pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto space-y-12 z-10">
      <div class="text-center space-y-2 max-w-3xl mx-auto">
        <h2 class="text-[#1a375b] heading-section font-bold tracking-tight">
          Encuentra el camino que tu institución necesita
        </h2>
        <p class="text-[#1a375b] text-sm sm:text-base md:text-lg font-medium tracking-wide">
          Seis líneas para impulsar tu próximo paso
        </p>
      </div>

      <!-- Grilla de las 6 Tarjetas -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7 lg:gap-8">
        {solutions.map((sol) => (
          <div class="card-solution group flex flex-col justify-between">
            <div class="flex flex-col items-center text-center space-y-3 w-full">
              <div class="mb-1 text-[#f5a623] group-hover:scale-105 transition-transform duration-300 flex items-center justify-center">
                <Fragment set:html={sol.icon} />
              </div>
              
              <div class="space-y-0.5">
                <p class="text-white text-xs sm:text-[13px] font-bold tracking-widest uppercase opacity-90">
                  {sol.prefix}
                </p>
                <h3 class="text-[#f5a623] text-xl sm:text-2xl font-bold font-heading">
                  {sol.name}
                </h3>
              </div>
              
              <p class="text-white/95 text-xs sm:text-[13.5px] font-normal leading-relaxed text-balance max-w-[270px] mx-auto">
                {sol.description}
              </p>
            </div>

            <div class="pt-5 mt-auto w-full flex justify-center">
              <a 
                href={sol.link} 
                class="btn-gold !rounded-full !py-2.5 !px-6 !text-xs sm:!text-[14px] !font-bold w-full max-w-[230px] text-center justify-center inline-flex items-center gap-1.5 shadow-md hover:shadow-lg transition-all"
              >
                <span>Ver solución</span>
                <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 font-bold">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-[#091E3A] text-white text-center">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-2xl sm:text-4xl font-bold font-heading">
        ¿Listo para dar el siguiente paso con CEDEPRO?
      </h2>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mx-auto">
        Nuestros consultores están listos para analizar tus necesidades y estructurar un plan a la medida de tu institución.
      </p>
      <div class="pt-2">
        <a href="/contactanos" class="btn-gold !rounded-full !px-8 !py-3.5 !text-sm !font-bold shadow-xl inline-flex items-center gap-2">
          <span>Agendar reunión de asesoría</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
