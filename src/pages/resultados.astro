---
import Layout from '../layouts/Layout.astro';

// Estadísticas de Impacto Comprobado
const impactStats = [
  { value: '+70', label: 'CARRERAS APROBADAS', desc: 'Diseños curriculares y programas de tercer y cuarto nivel validados y acreditados.' },
  { value: '+10', label: 'INSTITUTOS CREADOS', desc: 'Acompañamiento integral desde el estudio de factibilidad hasta la autorización oficial.' },
  { value: '+2500', label: 'PROFESIONALES CAPACITADOS', desc: 'Docentes, directivos y personal técnico formados con metodologías de vanguardia.' },
  { value: '+30', label: 'INSTITUCIONES ASESORADAS', desc: 'Universidades e institutos en todo el Ecuador confían en nuestro respaldo.' }
];

const testimonials = [
  {
    quote: 'Trabajar de la mano de profesionales como CEDEPRO ha multiplicado los resultados esperados en nuestra institución y ha acortado el camino hacia nuestros objetivos más ambiciosos.',
    name: 'Ramón Pineda',
    role: 'Rector CGE',
    image: '/assets/home/rector-cge-ramon-pineda.png'
  }
];

const achievements = [
  {
    title: 'Aprobación de Carreras en Tiempo Récord',
    description: 'Estructuración técnico-pedagógica alineada a las normativas del CES y CACES, logrando dictámenes favorables con máxima celeridad.'
  },
  {
    title: 'Obtención de Condición de Superior Universitario',
    description: 'Acompañamiento documental y metodológico para institutos superiores que alcanzaron el estatus universitario.'
  },
  {
    title: 'Implementación de Sistemas de Gestión de Calidad',
    description: 'Certificación de procesos educativos bajo la norma internacional ISO 9001:2015, garantizando trazabilidad y mejora continua.'
  }
];
---

<Layout 
  title="Resultados e Impacto – Cedepro Ecuador"
  description="Conoce el impacto real de CEDEPRO: más de 70 carreras aprobadas, 10 institutos creados y más de 30 instituciones asesoradas en el Ecuador."
>
  <!-- Hero Section -->
  <section class="relative bg-[#07192F] py-20 sm:py-28 px-4 sm:px-6 lg:px-8 text-white overflow-hidden">
    <div class="relative max-w-5xl mx-auto text-center space-y-6 z-10">
      <p class="text-[#df9417] text-xs sm:text-sm font-bold tracking-widest uppercase">
        IMPACTO COMPROBADO
      </p>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-heading tracking-tight leading-tight">
        Resultados que transforman la educación superior
      </h1>

      <p class="text-slate-200 text-base sm:text-lg md:text-xl font-normal max-w-3xl mx-auto leading-relaxed">
        Lo que hacemos se demuestra en el camino recorrido: datos tangibles, instituciones fortalecidas y proyectos educativos sostenibles en el tiempo.
      </p>
    </div>
  </section>

  <!-- Métricas Principales -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-6xl mx-auto space-y-12">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-4xl font-bold text-[#091E3A] font-heading">
          Nuestras cifras en estos 5 años
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Métricas auditadas y respaldadas por nuestras instituciones aliadas
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {impactStats.map((stat) => (
          <div class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-all text-center flex flex-col justify-between">
            <div>
              <p class="text-4xl sm:text-5xl font-extrabold text-[#df9417] font-heading mb-2">
                {stat.value}
              </p>
              <h3 class="text-xs sm:text-sm font-bold text-[#091E3A] tracking-wider uppercase mb-3">
                {stat.label}
              </h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed pt-2 border-t border-slate-100">
              {stat.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sección Testimonio Rector -->
  <section class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-cover bg-center overflow-hidden" style="background-image: url('/assets/home/img-parte-4-home.webp');">
    <div class="absolute inset-0 bg-[#071d36]/75 backdrop-blur-[2px] pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto space-y-10 z-10 text-white">
      <div class="text-center space-y-2">
        <p class="text-[#f5a623] text-xs sm:text-sm font-bold tracking-wider uppercase">
          VOZ DE NUESTROS ALIADOS
        </p>
        <h2 class="text-2xl sm:text-4xl font-bold font-heading">
          Experiencias reales de líderes educativos
        </h2>
      </div>

      {testimonials.map((t) => (
        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-8 sm:p-12 shadow-2xl flex flex-col md:flex-row items-center gap-8">
          <div class="shrink-0 w-28 h-28 sm:w-36 sm:h-36 rounded-full overflow-hidden border-4 border-white/30 shadow-xl bg-slate-700">
            <img 
              src={t.image} 
              alt={t.name} 
              class="w-full h-full object-cover"
              width="144"
              height="144"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="space-y-4 text-center md:text-left flex-1">
            <div class="text-white/40 text-6xl font-serif leading-none select-none -mb-6">
              “
            </div>
            <p class="text-slate-100 text-base sm:text-lg lg:text-xl font-normal leading-relaxed italic">
              {t.quote}
            </p>
            <div class="pt-2 border-t border-white/15">
              <p class="font-bold text-white text-lg font-heading">{t.name}</p>
              <p class="text-xs sm:text-sm text-[#f5a623] font-medium">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Casos y Logros -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-5xl mx-auto space-y-10">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-4xl font-bold text-[#091E3A] font-heading">
          Áreas de éxito institucional
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Cómo transformamos desafíos normativos en fortalezas institucionales
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {achievements.map((item, idx) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3">
            <span class="w-8 h-8 rounded-full bg-[#df9417] text-white font-bold text-sm flex items-center justify-center">
              {idx + 1}
            </span>
            <h3 class="text-lg font-bold text-[#091E3A] font-heading">
              {item.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-[#091E3A] text-white text-center">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-2xl sm:text-4xl font-bold font-heading">
        Haz que tu institución sea nuestro próximo caso de éxito
      </h2>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mx-auto">
        Comunícate con nuestro equipo técnico y diseñemos una hoja de ruta con metas alcanzables.
      </p>
      <div class="pt-2">
        <a href="/contactanos" class="btn-gold !rounded-full !px-8 !py-3.5 !text-sm !font-bold shadow-xl inline-flex items-center gap-2">
          <span>Solicitar diagnóstico inicial</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
