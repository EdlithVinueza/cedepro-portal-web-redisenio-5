---
import Layout from '../layouts/Layout.astro';

// 3 Aliados Estratégicos Destacados
const strategicPartners = [
  {
    name: 'cavilar®',
    subbrand: 'EL SIGUIENTE PASO',
    description: 'Consultores y asesores corporativos especializados en alta gerencia y gobernanza institucional.',
    logo: '/assets/home/logos/01-300x99.webp',
    width: 270,
    height: 89
  },
  {
    name: 'DIGITAL MIND',
    subbrand: 'POWERED BY DATA',
    description: 'Investigación, análisis de datos e inteligencia artificial aplicados al sector educativo.',
    logo: '/assets/home/logos/02.webp',
    width: 230,
    height: 95
  },
  {
    name: 'ARG & CIENCIALINK GROUP-EC',
    subbrand: 'EDUCACIÓN & INNOVACIÓN',
    description: 'Consultores en educación, publicaciones indexadas e innovación pedagógica continua.',
    logo: '/assets/home/logos/04-300x120.webp',
    width: 270,
    height: 108
  }
];

// 16 Instituciones de Educación Superior y Aliados Académicos
const clientLogos = [
  { name: 'CGE', file: 'logo-1-home-cge.webp' },
  { name: 'Politécnico del Ecuador', file: 'logo-2-home-politec.webp' },
  { name: 'ESPE Universidad Fuerzas Armadas', file: 'logo-3-home-espe.webp' },
  { name: 'Amawtay Wasi', file: 'logo-4-home-amarawasi.webp' },
  { name: 'UMA', file: 'logo-5-home-uma.webp' },
  { name: 'ITSQM', file: 'logo-6-home-itsqm.webp' },
  { name: 'American College', file: 'logo-7-home-americancollage.webp' },
  { name: 'Fe y Alegría', file: 'logo-8-home-feyalegria.webp' },
  { name: 'Cotopaxi', file: 'logo-9-home-cotopaxi.webp' },
  { name: 'Esquel Clic', file: 'logo-10-home-esquelclic.webp' },
  { name: 'ITCA Universitario', file: 'logo-11-home-itca.webp' },
  { name: 'ISTI', file: 'logo-12-home-isti.webp' },
  { name: 'Universitario de Formación', file: 'logo-13-home-universitariodeformacion.webp' },
  { name: 'ISTY', file: 'logo-14-home-isty.webp' },
  { name: 'UMET Metropolitana', file: 'logo-15-home-umet.webp' },
  { name: 'Tecnoecuatoriano', file: 'logo-16-home-tecnoecuatoriano.webp' }
];
---

<Layout 
  title="Aliados Estratégicos – Cedepro Ecuador"
  description="Red de aliados estratégicos e instituciones de educación superior que confían en Cedepro Ecuador."
>
  <!-- Hero Section -->
  <section class="relative bg-[#07192F] py-20 sm:py-28 px-4 sm:px-6 lg:px-8 text-white text-center overflow-hidden">
    <div class="relative max-w-5xl mx-auto space-y-6 z-10">
      <p class="text-[#df9417] text-xs sm:text-sm font-bold tracking-widest uppercase">
        RED COLABORATIVA
      </p>
      
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-heading tracking-tight leading-tight">
        Aliados que fortalecen nuestras soluciones
      </h1>

      <p class="text-slate-200 text-base sm:text-lg md:text-xl font-normal max-w-3xl mx-auto leading-relaxed">
        Creemos firmemente en el poder de la cooperación. Trabajamos junto a organizaciones líderes e instituciones de prestigio para multiplicar el impacto en la educación superior.
      </p>
    </div>
  </section>

  <!-- 3 Aliados Estratégicos Destacados -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#df9417]">
    <div class="max-w-6xl mx-auto space-y-12 text-center">
      <div class="space-y-2">
        <p class="text-white/90 text-xs sm:text-sm font-bold tracking-widest uppercase">
          ALIANZAS CORPORATIVAS
        </p>
        <h2 class="text-white heading-section font-bold">
          Socios estratégicos de primer nivel
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        {strategicPartners.map((partner) => (
          <div class="card-partner group flex flex-col justify-between h-full bg-white p-6 sm:p-8 rounded-2xl shadow-lg">
            <div class="my-auto flex items-center justify-center h-28 sm:h-32 w-full px-2">
              <img 
                src={partner.logo} 
                alt={partner.name} 
                class="max-h-20 sm:max-h-24 max-w-[240px] w-auto object-contain transition-transform duration-300 group-hover:scale-105" 
                width={partner.width} 
                height={partner.height} 
                decoding="async" 
              />
            </div>
            <div class="pt-5 mt-auto border-t border-slate-100 text-center">
              <p class="text-xs font-bold text-[#df9417] tracking-wider uppercase mb-1">{partner.subbrand}</p>
              <p class="text-sm text-[#1a375b] font-medium leading-snug">
                {partner.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 16 Instituciones de Educación Superior -->
  <section class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-cover bg-center overflow-hidden" style="background-image: url('/assets/home/img-parte-5-home.webp');">
    <div class="absolute inset-0 bg-[#07192F]/85 backdrop-blur-[2px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto space-y-12 z-10 text-white">
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <p class="text-[#f5a623] text-xs sm:text-sm font-bold tracking-widest uppercase">
          CONFIANZA INSTITUCIONAL
        </p>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold font-heading">
          Instituciones de Educación Superior que confían en nosotros
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Universidades, escuelas politécnicas e institutos superiores tecnológicos que han impulsado su desarrollo con CEDEPRO.
        </p>
      </div>

      <!-- Grilla de Logos Institucionales -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-4 sm:gap-6">
        {clientLogos.map((client) => (
          <div class="bg-white/95 backdrop-blur-sm p-4 sm:p-6 rounded-2xl border border-white/20 shadow-md hover:bg-white hover:scale-105 transition-all flex items-center justify-center h-28 sm:h-32">
            <img 
              src={`/assets/home/logos/${client.file}`} 
              alt={client.name} 
              class="max-h-16 sm:max-h-20 max-w-[150px] w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-[#091E3A] text-white text-center">
    <div class="max-w-4xl mx-auto space-y-6">
      <h2 class="text-2xl sm:text-4xl font-bold font-heading">
        ¿Te gustaría sumarte como aliado estratégico?
      </h2>
      <p class="text-slate-200 text-sm sm:text-base max-w-2xl mx-auto">
        Exploremos oportunidades conjuntas de colaboración institucional, desarrollo de proyectos o convenios interinstitucionales.
      </p>
      <div class="pt-2">
        <a href="/contactanos" class="btn-gold !rounded-full !px-8 !py-3.5 !text-sm !font-bold shadow-xl inline-flex items-center gap-2">
          <span>Conversar con nuestra gerencia</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
