---
import Layout from '../layouts/Layout.astro';

// 6 Líneas de Solución CEDEPRO Oficiales
const solutions = [
  {
    name: 'ASESORÍA',
    subtitle: 'Decisiones con sustento.',
    description: 'Analizamos tu contexto y convertimos la incertidumbre en prioridades, escenarios y recomendaciones.',
    link: '/recursos#asesoria',
    icon: `<svg class="w-7 h-7 text-[#df9417]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="20" cy="16" r="6"/><path d="M9 38c0-5.5 4.9-10 11-10s11 4.5 11 10"/><path d="M30 9h9a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4h-2.5l-3.5 4v-4H30a4 4 0 0 1-4-4v-5a4 4 0 0 1 4-4z"/><circle cx="33.5" cy="15.5" r="0.8" fill="currentColor"/><circle cx="38" cy="15.5" r="0.8" fill="currentColor"/></svg>`
  },
  {
    name: 'FORMACIÓN',
    subtitle: 'Capacidades que se aplican.',
    description: 'Diseñamos experiencias para que docentes, directivos y equipos desarrollen competencias útiles para los retos reales.',
    link: '/recursos#formacion',
    icon: `<svg class="w-7 h-7 text-[#df9417]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 10 5 19l19 9 19-9-19-9z"/><path d="M12 22.5v7.5c0 3.8 5.4 7 12 7s12-3.2 12-7v-7.5"/><path d="M38 19v12"/><circle cx="38" cy="32" r="1.5" fill="currentColor"/></svg>`
  },
  {
    name: 'GESTIÓN',
    subtitle: 'Orden que produce resultados.',
    description: 'Fortalecemos procesos, indicadores, evidencias y coordinación para trabajar con mayor claridad, control y eficiencia.',
    link: '/recursos#gestion',
    icon: `<svg class="w-7 h-7 text-[#df9417]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="12" r="3.5"/><circle cx="15" cy="15" r="3"/><circle cx="33" cy="15" r="3"/><path d="M10 23.5c0-2.2 1.8-4 4-4 .8 0 1.5.2 2.2.6"/><path d="M31.8 20.1c.7-.4 1.4-.6 2.2-.6 2.2 0 4 1.8 4 4"/><path d="M19 22c1.3-1.2 3.1-2 5-2s3.7.8 5 2"/><circle cx="24" cy="34" r="4"/><path d="M24 26.5v2.5M24 39v2.5M16.5 34H19M29 34h2.5M18.7 28.7l1.8 1.8M27.5 37.5l1.8 1.8M18.7 39.3l1.8-1.8M27.5 30.5l1.8-1.8"/></svg>`
  },
  {
    name: 'PROYECTOS',
    subtitle: 'Visión con ruta de ejecución.',
    description: 'Estructuramos iniciativas académicas, institucionales y de innovación para hacerlas viables, medibles y sostenibles.',
    link: '/recursos#proyectos',
    icon: `<svg class="w-7 h-7 text-[#df9417]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 5v3M13 8l2 2M29 8l-2 2"/><path d="M21 11a9 9 0 0 0-6.8 14.8c1.3 1.5 2 3.3 2 5.2h7.6"/><path d="M18.5 34.5h5.5M19.5 37.5h3.5"/><circle cx="31.5" cy="27.5" r="5"/><path d="M35.2 31.2l4.8 4.8"/></svg>`
  },
  {
    name: 'INTERNACIONAL',
    subtitle: 'Conexiones que abren oportunidades.',
    description: 'Impulsamos cooperación, alianzas y proyección para ampliar el alcance institucional.',
    link: '/recursos#internacional',
    icon: `<svg class="w-7 h-7 text-[#df9417]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="11"/><path d="M13 24h22"/><path d="M24 13c-3 3.5-4.8 7-4.8 11s1.8 7.5 4.8 11"/><path d="M24 13c3 3.5 4.8 7 4.8 11s-1.8 7.5-4.8 11"/><path d="M8 20.5C9.5 14 17 9.5 25.5 10c7.5.5 13 4.5 13.5 9.5-.5 5-5.5 8.5-12.5 9.5"/><path d="M36 15l4 4 4.5-2.5"/></svg>`
  },
  {
    name: 'TECH',
    subtitle: 'Tecnología aplicada a la transformación.',
    description: 'Integramos datos, herramientas digitales e inteligencia artificial para mejorar la gestión y la experiencia educativa.',
    link: '/recursos#tech',
    icon: `<svg class="w-7 h-7 text-[#df9417]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="34" height="23" rx="3"/><path d="M24 32v7M18 39h12"/><circle cx="24" cy="20.5" r="3"/><path d="M24 15.5v1.5M24 24v1.5M19 20.5h1.5M27.5 20.5H29M20.5 17l1.1 1.1M26.4 22.9l1.1 1.1M20.5 24l1.1-1.1M26.4 18.1l1.1-1.1"/></svg>`
  }
];

// Estadísticas de Impacto Comprobado
const stats = [
  { value: '+70', label: 'Carreras aprobadas' },
  { value: '+10', label: 'Institutos creados' },
  { value: '+2.500', label: 'Profesionales capacitados' },
  { value: '+30', label: 'Instituciones asesoradas' }
];

// 5 Valores Corporativos
const values = [
  {
    name: 'Excelencia',
    bg: 'bg-amber-50 text-[#df9417] border-amber-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>`
  },
  {
    name: 'Innovación',
    bg: 'bg-sky-50 text-sky-600 border-sky-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>`
  },
  {
    name: 'Compromiso',
    bg: 'bg-rose-50 text-rose-500 border-rose-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>`
  },
  {
    name: 'Colaboración',
    bg: 'bg-indigo-50 text-indigo-600 border-indigo-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>`
  },
  {
    name: 'Impacto',
    bg: 'bg-amber-50 text-amber-600 border-amber-200',
    icon: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="2"/>`
  }
];
---

<Layout 
  title="Nosotros – CEDEPRO Ecuador | El Aliado Estratégico para tu Institución"
  description="Conoce a CEDEPRO: 5 años construyendo soluciones para la educación superior. Asesoría, formación, gestión, proyectos, cooperación y tecnología."
  image="/assets/cinco-años/cinco-anos-azul.webp"
>
  
  <!-- =========================================================================
       1. SECCIÓN 1: HERO (Fondo Blanco Panorámico + img-1-nosotros estilo index.astro)
       ========================================================================= -->
  <section class="hero-section-nosotros relative bg-white overflow-hidden">
    
    <!-- Capa de imagen de fondo adaptable (Desktop/Mobile) -->
    <div class="hero-bg-layer-nosotros" aria-hidden="true"></div>

    <!-- Difuminado horizontal continuo para Desktop (BLANCO) -->
    <div class="hero-desktop-overlay-nosotros" aria-hidden="true"></div>

    <!-- Difuminado vertical para Móviles (BLANCO) -->
    <div class="hero-mobile-overlay-nosotros" aria-hidden="true"></div>

    <div class="hero-content-nosotros relative max-w-7xl w-full mx-auto z-10 px-4 sm:px-6 lg:px-12">
      <div class="hero-text-block-nosotros space-y-3 sm:space-y-3.5 lg:space-y-4">
        
        <!-- Badge 5 AÑOS • 4 caminos • Un mismo propósito -->
        <div class="inline-flex items-end gap-2.5 sm:gap-3 flex-wrap">
          <img 
            src="/assets/cinco-años/cinco-anos-azul.webp" 
            alt="5 AÑOS" 
            class="h-9 sm:h-10 md:h-12 lg:h-14 w-auto object-contain shrink-0"
            width="160"
            height="60"
            decoding="async"
            loading="eager"
          />
          <div class="flex items-center gap-1.5 sm:gap-2 text-[#091E3A] font-medium text-xs sm:text-[13px] md:text-sm tracking-wide pb-0.5 sm:pb-1">
            <span class="text-[#c67a00] text-xs sm:text-sm font-bold">•</span> 
            <span class="font-normal text-[#091E3A]">4 caminos</span> 
            <span class="text-[#c67a00] text-xs sm:text-sm font-bold">•</span> 
            <span class="font-normal text-[#091E3A]">Un mismo propósito</span>
          </div>
        </div>

        <!-- Titular Principal del Hero -->
        <h1 class="text-[#091E3A] text-2xl sm:text-3xl md:text-4xl lg:text-[2.35rem] xl:text-[2.6rem] font-bold !leading-[1.14] tracking-tight font-heading">
          El aliado estratégico para el <br />
          <span class="text-[#091E3A]">crecimiento de tu institución.</span>
        </h1>

        <!-- Párrafo descriptivo -->
        <p class="text-slate-600 text-xs sm:text-sm md:text-[15px] font-normal leading-relaxed max-w-xl text-balance">
          Las instituciones de educación superior enfrentan decisiones cada vez más complejas. En CEDEPRO reunimos experiencia, criterio técnico e innovación aplicada para ayudarte a tomar mejores decisiones, fortalecer tus equipos, ordenar tu gestión y convertir tus oportunidades en proyectos sostenibles.
        </p>

        <!-- Botones de Acción Contextuales -->
        <div class="pt-1 sm:pt-1.5 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 w-full sm:w-auto">
          <!-- Botón 1: Conoce nuestro camino (Dorado oscuro sobre fondo blanco) -->
          <a 
            href="#porque" 
            class="btn-gold-dark !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold w-full sm:w-auto text-center justify-center inline-flex items-center !leading-none"
          ><span class="inline-flex items-center justify-center text-center leading-none">Conoce nuestro camino <span class="inline-block ml-1.5 leading-none">→</span></span></a>

          <!-- Botón 2: Solicita una asesoría (Borde dorado, hover dorado) -->
          <a 
            href="/contactanos" 
            class="btn-outline-gold-navy !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold w-full sm:w-auto text-center justify-center inline-flex items-center !leading-none"
          ><span class="inline-flex items-center justify-center text-center leading-none">Solicita una asesoría</span></a>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. SECCIÓN 2: NUESTRO PORQUÉ (Fondo img-2-nosotros.webp)
       ========================================================================= -->
  <section id="porque" class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 text-white overflow-hidden bg-[#07192F]">
    <!-- Imagen de Fondo con Overlay Azul Marino y Difuminado -->
    <div class="absolute inset-0 z-0">
      <picture>
        <source srcset="/assets/cinco-años/img-2-nosotros.webp" type="image/webp" />
        <img 
          src="/assets/cinco-años/img-2-nosotros.png" 
          alt="Instalaciones y espacio de trabajo CEDEPRO" 
          class="w-full h-full object-cover object-center"
          width="1920"
          height="1080"
          decoding="async"
        />
      </picture>
      <div class="absolute inset-0 bg-[#07192F]/88 backdrop-blur-[2px]"></div>
    </div>

    <div class="relative max-w-4xl mx-auto text-center space-y-6 z-10">
      <p class="text-[#df9417] text-xs sm:text-sm font-bold tracking-widest uppercase">
        NUESTRO PORQUÉ
      </p>

      <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold font-heading leading-tight tracking-tight text-white">
        La transformación educativa necesita un aliado que entienda el contexto
      </h2>

      <div class="space-y-4 text-slate-200 text-sm sm:text-base md:text-lg leading-relaxed max-w-3xl mx-auto">
        <p>
          Crear una carrera, responder a una exigencia normativa, fortalecer la calidad, desarrollar nuevas capacidades, ordenar procesos o abrir una oportunidad de crecimiento no son tareas aisladas. Cada decisión impacta la sostenibilidad, la reputación y el futuro de una institución.
        </p>
        <p>
          Por eso CEDEPRO trabaja junto a universidades e institutos para convertir desafíos complejos en rutas claras de acción. Escuchamos la realidad de cada institución, analizamos sus prioridades y construimos soluciones que conectan estrategia, academia, gestión e innovación.
        </p>
      </div>

      <div class="pt-3">
        <a 
          href="#esencia" 
          class="btn-gold !rounded-full !px-8 !py-3.5 !text-sm sm:!text-[15px] !font-bold shadow-lg inline-flex items-center gap-2 group"
        >
          <span>Conoce cómo podemos acompañarte</span>
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 font-bold">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. SECCIÓN 3: NUESTRA ESENCIA (Fondo Claro + img-3-nosotros)
       ========================================================================= -->
  <section id="esencia" class="relative py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Contenido Izquierdo -->
        <div class="lg:col-span-7 space-y-6 text-left">
          
          <p class="text-[#c67a00] text-xs sm:text-sm font-bold tracking-widest uppercase">
            NUESTRA ESENCIA
          </p>

          <div class="space-y-1.5">
            <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap">
              <img 
                src="/assets/cinco-años/cinco-anos-azul.webp" 
                alt="5 AÑOS" 
                class="h-7 sm:h-9 w-auto object-contain inline-block shrink-0"
                width="130"
                height="48"
                decoding="async"
              />
              <span class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#c67a00] font-heading">
                construyendo soluciones
              </span>
            </div>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#091E3A] font-heading leading-tight">
              que ayudan a las instituciones a avanzar
            </h2>
          </div>

          <div class="space-y-4 text-slate-600 text-sm sm:text-base leading-relaxed">
            <p>
              CEDEPRO es un aliado estratégico de las instituciones de educación superior. Nacimos para acompañar decisiones académicas e institucionales y hoy evolucionamos hacia un ecosistema de soluciones que integra asesoría, formación, gestión, proyectos, cooperación y tecnología.
            </p>
            <p>
              Nuestro trabajo no termina en una recomendación o en la entrega de un documento. Acompañamos la comprensión del desafío, el diseño de la respuesta, su implementación y el seguimiento de los resultados. Así convertimos la experiencia en acción y la acción en crecimiento sostenible.
            </p>
          </div>

          <!-- Banner / Píldora Azul Marino -->
          <div class="pt-2">
            <div class="inline-block bg-[#091E3A] text-white px-5 sm:px-6 py-3 rounded-xl sm:rounded-2xl text-xs sm:text-sm md:text-[14.5px] font-bold tracking-wide shadow-md">
              Experiencia para asesorar, formar, gestionar y proyectar
            </div>
          </div>

        </div>

        <!-- Imagen Derecha: img-3-nosotros -->
        <div class="lg:col-span-5 relative flex justify-center">
          <div class="relative w-full max-w-lg lg:max-w-none rounded-2xl sm:rounded-3xl overflow-hidden shadow-xl border border-slate-100">
            <picture>
              <source srcset="/assets/cinco-años/img-3-nosotros.webp" type="image/webp" />
              <img 
                src="/assets/cinco-años/img-3-nosotros.png" 
                alt="Auditorio y conferencias de formación CEDEPRO" 
                class="w-full h-auto object-cover"
                width="1200"
                height="800"
                decoding="async"
              />
            </picture>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. SECCIÓN 4: 6 LÍNEAS DE EXPANSIÓN (Fondo Dorado + 6 Tarjetas Blancas)
       ========================================================================= -->
  <section id="soluciones" class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#df9417] text-white overflow-hidden">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Encabezado de Sección -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <p class="text-white/90 text-xs sm:text-sm font-bold tracking-widest uppercase">
          CUATRO CAMINOS Y DOS LÍNEAS DE EXPANSIÓN
        </p>
        <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold font-heading text-white tracking-tight">
          Una solución para cada desafío institucional
        </h2>
        <p class="text-white/95 text-xs sm:text-sm md:text-base leading-relaxed">
          Una institución no siempre necesita lo mismo. A veces necesita decidir con mayor claridad; otras, formar a sus equipos, ordenar su operación o convertir una oportunidad en un proyecto viable. Por eso organizamos nuestra experiencia en seis líneas conectadas:
        </p>
      </div>

      <!-- Grilla de las 6 Tarjetas Blancas -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4 sm:gap-5">
        {solutions.map((sol) => (
          <div class="bg-white rounded-2xl p-5 sm:p-6 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-between text-center group hover:-translate-y-1">
            <div class="space-y-3 flex flex-col items-center">
              
              <!-- Círculo Azul Marino con Icono Dorado Oficial -->
              <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-[#091E3A] flex items-center justify-center p-3 shadow-sm group-hover:scale-105 transition-transform">
                <Fragment set:html={sol.icon} />
              </div>

              <!-- Título de la Solución -->
              <h3 class="text-[#091E3A] text-sm sm:text-base font-bold font-heading tracking-wide uppercase">
                {sol.name}
              </h3>

              <!-- Subtítulo Destacado -->
              <p class="text-[#091E3A] text-xs sm:text-[13px] font-bold leading-snug">
                {sol.subtitle}
              </p>

              <!-- Descripción -->
              <p class="text-slate-600 text-xs leading-relaxed text-balance">
                {sol.description}
              </p>
            </div>

            <!-- Botón Conoce la solución -->
            <div class="pt-5 mt-auto w-full">
              <a 
                href={sol.link} 
                class="w-full inline-flex items-center justify-center text-center text-xs font-semibold text-[#091E3A] border border-slate-300 rounded-full py-2 px-3 hover:bg-[#091E3A] hover:text-white hover:border-[#091E3A] transition-all duration-200 group-hover:shadow-sm"
              >
                <span>Conoce la solución</span>
                <span class="ml-1 font-bold">→</span>
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================================
       5. SECCIÓN 5: NUESTRO IMPACTO & VALORES (Fondo Claro)
       ========================================================================= -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto space-y-14">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        
        <!-- Columna Izquierda: NUESTRO IMPACTO (span 6) -->
        <div class="lg:col-span-6 space-y-6">
          <div class="space-y-2">
            <p class="text-[#c67a00] text-xs sm:text-sm font-bold tracking-widest uppercase">
              NUESTRO IMPACTO
            </p>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#091E3A] font-heading">
              Resultados que respaldan nuestro trabajo
            </h2>
          </div>

          <!-- 4 Cifras -->
          <div class="grid grid-cols-2 gap-4 sm:gap-6 pt-2">
            {stats.map((st) => (
              <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm text-left hover:shadow-md transition-shadow">
                <span class="text-3xl sm:text-4xl font-extrabold text-[#091E3A] font-heading tracking-tight block">
                  {st.value}
                </span>
                <span class="text-xs sm:text-sm font-semibold text-slate-600 mt-1 block">
                  {st.label}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Columna Derecha: Nuestros valores (span 6) -->
        <div class="lg:col-span-6 space-y-6">
          <div class="space-y-2">
            <h2 class="text-2xl sm:text-3xl font-bold text-[#091E3A] font-heading">
              Nuestros valores
            </h2>
          </div>

          <!-- Fila de Valores con Iconos Redondeados -->
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-2">
            {values.map((v) => (
              <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col items-center text-center space-y-2.5 hover:shadow-md transition-shadow">
                <div class={`w-12 h-12 rounded-full flex items-center justify-center border ${v.bg}`}>
                  <svg class="w-6 h-6 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24">
                    <Fragment set:html={v.icon} />
                  </svg>
                </div>
                <span class="text-xs sm:text-sm font-bold text-[#091E3A] font-heading">
                  {v.name}
                </span>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Barra de Certificación IAS / Staregister -->
      <div class="pt-6 border-t border-slate-200 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-center">
        <span class="text-sm sm:text-base font-bold text-[#091E3A] tracking-wide">
          Certificación
        </span>
        <img 
          src="/assets/brand/ISO.webp" 
          alt="IAS STAREGISTER ISO 9001:2015" 
          class="h-10 sm:h-12 w-auto object-contain"
          width="120"
          height="60"
          decoding="async"
        />
        <span class="text-sm sm:text-base font-medium text-slate-700">
