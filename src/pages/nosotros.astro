 height="60"
 decoding="async"
 />
 <div class="flex flex-col text-left">
 <span class="text-sm sm:text-base font-normal text-[#1a375b] leading-tight">
 Calidad que
 </span>
 <span class="text-sm sm:text-base font-normal text-[#1a375b] leading-tight border-b-2 border-[#df9417] pb-0.5">
 genera confianza
 </span>
 </div>
 </div>

 </div>
 </section>

 <!-- =========================================================================
 7. SECCIÓN 7: NUESTRO NORTE (Misión y Visión)
 ========================================================================= -->
 <section class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-cover bg-center overflow-hidden lg:min-h-[560px] lg:max-h-[820px] lg:h-[calc(100vh-5rem)] lg:flex lg:flex-col lg:justify-center" style="background-image: url('/assets/nosotros/img-nosotros-section-4.webp');">
