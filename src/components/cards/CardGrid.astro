---
interface Props {
  /** Cantidad de tarjetas para equilibrar las filas en escritorio (máximo cuatro por fila). */
  count: number;
  /** Ancho máximo del grupo; permite compactar solo una sección. */
  maxWidth?: string;
}
const { count, maxWidth = "80rem" } = Astro.props;
const total = Math.max(1, Math.floor(count));
// Hasta cuatro tarjetas comparten una fila. Los grupos pares usan filas iguales.
// Los impares se reparten en filas de tamaño parecido y la última queda centrada.
const columns = total <= 4
  ? total
  : total % 2 === 0
    ? [4, 3, 2].find((size) => total % size === 0) ?? 2
    : Math.ceil(total / Math.ceil(total / 4));
---

<div class="card-grid" data-columns={columns} style={`--desktop-columns: ${columns}; --grid-max-width: ${maxWidth};`}>
  <slot />
</div>

<style>
  .card-grid {
    --columns: 1;
    --gap: 0.75rem;
    display: grid;
    grid-template-columns: repeat(calc(var(--columns) * 2), minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: var(--gap);
    width: 100%;
    max-width: var(--grid-max-width);
    margin-inline: auto;
  }

  .card-grid > :global(*) {
    grid-column: span 2;
    width: 100%;
    max-width: none;
    min-width: 0;
    height: 100%;
    margin-inline: 0;
  }

  @media (min-width: 640px) {
    .card-grid { --columns: 2; --gap: 1rem; }
    .card-grid > :global(:last-child:nth-child(odd)) { grid-column: 2 / span 2; }
  }

  @media (min-width: 1024px) {
    .card-grid { --columns: var(--desktop-columns); }
    .card-grid > :global(:last-child:nth-child(odd)) { grid-column: span 2; }
    .card-grid[data-columns="2"] > :global(:last-child:nth-child(odd)) { grid-column: 2 / span 2; }
    .card-grid[data-columns="3"] > :global(:nth-child(3n + 1):nth-last-child(2)) { grid-column: 2 / span 2; }
    .card-grid[data-columns="3"] > :global(:nth-child(3n + 1):last-child) { grid-column: 3 / span 2; }
    .card-grid[data-columns="4"] > :global(:nth-child(4n + 1):nth-last-child(3)) { grid-column: 2 / span 2; }
    .card-grid[data-columns="4"] > :global(:nth-child(4n + 1):nth-last-child(2)) { grid-column: 3 / span 2; }
    .card-grid[data-columns="4"] > :global(:nth-child(4n + 1):last-child) { grid-column: 4 / span 2; }
  }
</style>
