---
import { Icon } from 'astro-icon/components';

interface Props {
  /** Título de la solución */
  title: string;
  /** Descripción concisa */
  desc: string;
  /** Nombre del icono (ej: 'ion:business-outline') */
  icon: string;
  /** Color del icono */
  iconColor?: string;
  /** Texto del botón */
  buttonText?: string;
  /** Enlace del botón */
  buttonHref?: string;
  /** Clases CSS extra */
  class?: string;
}

const {
  title,
  desc,
  icon,
  iconColor = '#1665c0',
  buttonText = 'Conocer la solución →',
  buttonHref = '#contacto',
  class: className = '',
} = Astro.props;
---

<div class={`card-integration group ${className}`}>
  <Icon 
    name={icon} 
    class="w-11 h-11 xl:w-13 xl:h-13 stroke-1 shrink-0 self-center" 
    style={`color: ${iconColor};`}
  />
  
  <div class="flex flex-col justify-between h-full w-full min-w-0">
    <div>
      <h4 class="text-[#1a375b] text-[15px] xl:text-base font-bold leading-tight mb-1.5">
        {title}
      </h4>
      
      <p class="text-[#1a375b]/80 text-[12.5px] xl:text-[13px] leading-snug mb-3">
        {desc}
      </p>
    </div>
    
    <div class="mt-auto pt-1.5 w-full">
      <a 
        href={buttonHref} 
        class="w-full inline-flex items-center justify-center border border-[#1a375b] text-[#1a375b] hover:bg-[#1a375b] hover:text-white transition-colors bg-transparent rounded-full px-4 py-2 text-xs xl:text-[12.5px] font-bold shadow-sm text-center"
      >
        <span class="inline-flex items-center justify-center text-center leading-snug">
          {buttonText}
        </span>
      </a>
    </div>
  </div>
</div>
