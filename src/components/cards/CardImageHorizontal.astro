---
import { Icon } from "astro-icon/components";

interface Props {
  /** Título principal de la línea */
  title: string;
  /** Párrafo descriptivo */
  description: string;
  /** Ruta de la imagen lateral (opcional) */
  image?: string;
  /** Texto alternativo de la imagen */
  alt?: string;
  /** Nombre del icono de cabecera (ej: 'ion:document-text-outline') */
  icon?: string;
  /** Color de fondo del círculo del icono */
  iconBgColor?: string;
  /** Color del icono */
  iconColor?: string;
  /** Fondo opcional de la tarjeta; si se omite conserva el estilo actual. */
  backgroundColor?: string;
  /** Color opcional de título y descripción. */
  textColor?: string;
  /** Texto del botón */
  buttonText?: string;
  /** Enlace de destino del botón */
  buttonHref?: string;
  /** Clase CSS del botón (ej: 'btn-outline-navy', 'btn-outline-gold', 'btn-gold-dark') */
  buttonClass?: string;
  /** Disposición del icono ('row' = al lado, 'col' = arriba) */
  iconLayout?: "row" | "col";
  /** Clases CSS adicionales */
  class?: string;
}

const {
  title,
  description,
  image,
  alt = title,
  icon = "ion:document-text-outline",
  iconBgColor = "#1665c0",
  iconColor = "#ffffff",
  backgroundColor,
  textColor,
  buttonText = "Conocer más →",
  buttonHref = "/contactanos",
  buttonClass = "btn-outline-navy",
  iconLayout = "row",
  class: className = "",
} = Astro.props;
---

<div
  style={backgroundColor ? `background-color: ${backgroundColor};` : undefined}
  class={`card-image-horizontal flex rounded-2xl overflow-hidden ${image ? "card-image-horizontal--with-image flex-col md:flex-row" : "card-image-horizontal--without-image flex-col h-full"} group ${className}`}
>
  {
    image && (
      <div class="card-image-horizontal__media w-full md:w-[35%] h-56 md:h-auto relative shrink-0 overflow-hidden">
        <img
          src={image}
          alt={alt}
          class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-500"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
  <div
    class={`card-image-horizontal__body p-6 sm:p-8 w-full flex flex-col justify-between ${image ? "md:w-[65%]" : "flex-1"}`}
  >
    <div class="space-y-4">
      <div
        class={`flex ${iconLayout === "col" ? "flex-col items-start gap-4" : "items-center gap-3"}`}
      >
        <div
          class={`rounded-full flex items-center justify-center shrink-0 shadow-sm ${iconLayout === "col" ? "w-14 h-14" : "w-10 h-10 lg:w-11 lg:h-11"}`}
          style={`background-color: ${iconBgColor};`}
        >
          <Icon
            name={icon}
            class={`stroke-1 ${iconLayout === "col" ? "w-7 h-7" : "w-5 h-5 lg:w-6 lg:h-6"}`}
            style={`color: ${iconColor};`}
          />
        </div>
        <h3 class="text-[#1a375b] text-[1.05rem] sm:text-lg font-bold leading-tight truncate" style={textColor ? `color: ${textColor};` : undefined}>
          {title}
        </h3>
      </div>

      <p class="text-[#1a375b]/80 text-sm sm:text-[15px] leading-relaxed [text-wrap:wrap]" style={textColor ? `color: color-mix(in srgb, ${textColor} 80%, transparent);` : undefined}>
        {description}
      </p>
    </div>

    <div class="pt-4 mt-auto">
      <a
        href={buttonHref}
        class={buttonClass}
      >
        <span>
          {buttonText}
        </span>
      </a>
    </div>
  </div>
</div>

<style>
  .card-image-horizontal { height: 100%; min-width: 0; }
  .card-image-horizontal__body { min-width: 0; }
  .card-image-horizontal--without-image .card-image-horizontal__body { width: 100%; }
  h3 { min-width: 0; overflow-wrap: break-word; }
  .card-image-horizontal--with-image { flex-direction: column; }
  .card-image-horizontal--with-image .card-image-horizontal__media {
    width: 100%; flex: 0 0 auto; height: 14rem;
  }
  .card-image-horizontal--with-image .card-image-horizontal__body { width: 100%; }
  @media (min-width: 1024px) {
    .card-image-horizontal--with-image { flex-direction: row; }
    .card-image-horizontal--with-image .card-image-horizontal__media {
      width: 35%; flex-basis: 35%; height: auto;
    }
    .card-image-horizontal--with-image .card-image-horizontal__body { width: 65%; }
  }
</style>