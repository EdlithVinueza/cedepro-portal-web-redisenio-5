---
import { Icon } from 'astro-icon/components';

interface Props {
  /** Título del motivo / diferencial */
  title: string;
  /** Nombre del icono (ej: 'ion:school-outline') */
  icon: string;
  /** Variante de color del icono y su fondo: 'gold' | 'blue' | 'custom' */
  variant?: 'gold' | 'blue';
  /** Clases CSS extra */
  class?: string;
}

const {
  title,
  icon,
  variant = 'gold',
  class: className = '',
} = Astro.props;

const isGold = variant === 'gold';
const bgColor = isGold ? 'bg-[#df9417]/10' : 'bg-[#1665c0]/10';
const iconColor = isGold ? 'text-[#df9417]' : 'text-[#1665c0]';
---

<div class={`flex flex-row items-center text-left w-full lg:flex-1 gap-3 sm:gap-4 py-4 lg:py-0 px-2 lg:px-4 group justify-start ${className}`}>
  <div class={`w-12 h-12 lg:w-[3.5rem] lg:h-[3.5rem] rounded-full flex items-center justify-center shrink-0 ${bgColor} group-hover:scale-110 transition-transform`}>
    <Icon name={icon} class={`w-6 h-6 lg:w-[1.8rem] lg:h-[1.8rem] stroke-1 ${iconColor}`} />
  </div>
  <p class="text-[#1a375b] text-[13px] lg:text-[14px] font-medium leading-tight max-w-[140px] text-balance">
    {title}
  </p>
</div>
