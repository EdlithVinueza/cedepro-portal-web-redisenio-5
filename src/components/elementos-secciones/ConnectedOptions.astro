---
import { Icon } from "astro-icon/components";

interface Props {
  items: { label: string; href?: string; icon?: string }[];
  theme?: "light" | "dark";
  connector?: "dots" | "branches";
  label: string;
}
const { items, theme = "light", connector = "dots", label } = Astro.props;
---

<ul
  class:list={[
    "connected-options",
    `connected-options--${theme}`,
    `connected-options--${connector}`,
  ]}
  aria-label={label}
>
  {
    items.map((item) => (
      <li>
        <a
          href={item.href || "#"}
          class={
            theme === "dark"
              ? "btn-outline-white flex items-center gap-4 group"
              : "btn-outline-gold flex items-center gap-4 group"
          }
        >
          {item.icon && (
            <Icon 
              name={item.icon} 
              class={`w-6 h-6 shrink-0 transition-colors ${
                theme === "dark" 
                  ? "text-white group-hover:text-[#091E3A]" 
                  : "text-[#df9417] group-hover:text-white"
              }`} 
            />
          )}
          <span>{item.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .connected-options {
    --connector-color: var(--color-cedepro-gold);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0 0 0 1.75rem;
    margin: 0;
  }
  li {
    position: relative;
    min-width: 0;
  }
  li::before,
  li::after {
    content: "";
    position: absolute;
    background: var(--connector-color);
    pointer-events: none;
  }
  li::before {
    left: -1.25rem;
    top: calc(50% - 1px);
    width: 1.25rem;
    height: 2px;
  }
  li::after {
    left: -1.25rem;
    top: 0;
    bottom: -1rem;
    width: 2px;
  }
  li:first-child::after {
    top: 50%;
  }
  li:last-child::after {
    bottom: 50%;
  }
  .connected-options--dots li::before {
    left: -1.45rem;
    width: 0.5rem;
    height: 0.5rem;
    top: calc(50% - 0.25rem);
    border-radius: 50%;
  }
  .connected-options--dots li::after {
    opacity: 0.4;
  }
  a {
    width: fit-content;
    max-width: 100%;
    min-height: 48px;
    padding: 0.8rem 1.1rem;
    border-radius: 0.65rem;
    text-align: left;
    justify-content: flex-start;
    line-height: 1.4;
    font-size: 0.875rem;
  }
  a span {
    line-height: inherit;
    overflow-wrap: anywhere;
  }
  a:focus-visible {
    outline: 3px solid var(--connector-color);
    outline-offset: 4px;
  }
  @media (max-width: 639px) {
    a {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
