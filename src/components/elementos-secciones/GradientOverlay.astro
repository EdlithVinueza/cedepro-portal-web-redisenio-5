---
interface Props {
  /** 
   * Color base del degradado.
   * Acepta presets ('navy' | 'brand' | 'blue' | 'gold' | 'amber' | 'white' | 'dark') o cualquier color CSS hex/rgb/hsl.
   * Default: 'navy' (#07192F)
   */
  color?: string;

  /** 
   * Dirección en Desktop (md / lg).
   * 'to-r' | 'to-l' | 'to-b' | 'to-t' o cualquier ángulo CSS (ej: '90deg', '270deg').
   * Default: 'to-r'
   */
  desktopDirection?: 'to-r' | 'to-l' | 'to-b' | 'to-t' | string;

  /** 
   * Dirección en Móvil / Portrait (< md).
   * 'to-b' | 'to-t' | 'to-r' | 'to-l' o cualquier ángulo CSS (ej: '180deg', '0deg').
   * Default: 'to-b'
   */
  mobileDirection?: 'to-b' | 'to-t' | 'to-r' | 'to-l' | string;

  /** 
   * Dirección única (si se especifica, se usa tanto en móvil como desktop salvo que se indique mobileDirection/desktopDirection).
   */
  direction?: 'to-r' | 'to-l' | 'to-b' | 'to-t' | string;

  /** 
   * Porcentaje de cobertura sólida antes de comenzar a desvanecerse (0 a 100).
   * Por ejemplo: 20, 35, 50 (ocupa el 50% sólido y luego se difumina con suavidad natural).
   * Default: 25
   */
  coverage?: number;

  /** 
   * Porcentaje de cobertura sólida exclusiva para móvil. Si no se especifica, usa un valor proporcional adaptativo.
   */
  mobileCoverage?: number;

  /** 
   * Extensión total hasta donde el degradado llega a 0% de opacidad (fade final).
   * Default: 70
   */
  fadeEnd?: number;

  /** 
   * Extensión total del fade en móvil.
   */
  mobileFadeEnd?: number;

  /** 
   * Variante predefinida de curva si no se desea calcular por coverage:
   * 'smooth' (hero por defecto multi-stop) | 'compact' | 'subtle'
   */
  variant?: 'smooth' | 'compact' | 'subtle';

  /**
   * Selector CSS del contenedor de texto/botones a medir (ej: '.hero-text-block', '.section-content').
   * La función medirá la posición exacta de la última letra y botón para delimitar el degradado.
   */
  targetContentSelector?: string;

  /**
   * Activa el cálculo automático de la cobertura del degradado según la última letra/botón.
   */
  autoCalculateCoverage?: boolean;

  /** Margen de seguridad en px tras la última letra/botón (default: 20) */
  bufferPx?: number;

  /** Extensión porcentual del difuminado tras terminar el área sólida (default: 28) */
  fadeSpan?: number;

  /** Clases CSS adicionales (ej: 'z-10', 'mix-blend-multiply', etc.) */
  class?: string;

  /** Atributos HTML extra */
  id?: string;
}

const {
  color = '#07192F',
  direction,
  desktopDirection = direction || 'to-r',
  mobileDirection = direction || 'to-b',
  coverage,
  mobileCoverage,
  fadeEnd,
  mobileFadeEnd,
  variant = 'smooth',
  targetContentSelector,
  autoCalculateCoverage = Boolean(targetContentSelector),
  bufferPx = 20,
  fadeSpan = 28,
  class: className = '',
  id,
} = Astro.props;

// Mapeo de colores predefinidos de la marca CEDEPRO
const colorPresets: Record<string, string> = {
  navy: '#07192F',
  brand: '#091E3A',
  blue: '#1a375b',
  gold: '#df9417',
  amber: '#f5a623',
  dark: '#050d1a',
  white: '#ffffff',
};

const resolvedColor = colorPresets[color] || color;

// Mapeo de alias de direcciones a CSS estándar
const directionMap: Record<string, string> = {
  'to-r': '90deg',
  'to-l': '270deg',
  'to-b': '180deg',
  'to-t': '0deg',
};

const resolvedDesktopDir = directionMap[desktopDirection] || desktopDirection;
const resolvedMobileDir = directionMap[mobileDirection] || mobileDirection;

// Función generadora de gradiente multi-parada natural y continuo (curva suavizada)
function buildMultiStopGradient(dir: string, solidPercent: number, endPercent: number): string {
  const solid = Math.max(0, Math.min(100, solidPercent));
  const end = Math.max(solid + 10, Math.min(100, endPercent));
  const span = end - solid;

  const p1 = Math.round(solid);
  const p2 = Math.round(solid + span * 0.20);
  const p3 = Math.round(solid + span * 0.40);
  const p4 = Math.round(solid + span * 0.60);
  const p5 = Math.round(solid + span * 0.80);
  const p6 = Math.round(end);

  return `linear-gradient(${dir}, ${resolvedColor} 0%, ${resolvedColor} ${p1}%, color-mix(in srgb, ${resolvedColor} 85%, transparent) ${p2}%, color-mix(in srgb, ${resolvedColor} 60%, transparent) ${p3}%, color-mix(in srgb, ${resolvedColor} 32%, transparent) ${p4}%, color-mix(in srgb, ${resolvedColor} 10%, transparent) ${p5}%, transparent ${p6}%)`;
}

// Resolver configuraciones Desktop
const dSolid = coverage !== undefined ? coverage : (variant === 'compact' ? 0 : 25);
const dEnd = fadeEnd !== undefined ? fadeEnd : (variant === 'compact' ? 45 : Math.min(100, dSolid + 48));

// Resolver configuraciones Mobile
const mSolid = mobileCoverage !== undefined ? mobileCoverage : (coverage !== undefined ? Math.max(10, Math.round(coverage * 0.65)) : (variant === 'compact' ? 0 : 20));
const mEnd = mobileFadeEnd !== undefined ? mobileFadeEnd : (fadeEnd !== undefined ? fadeEnd : Math.min(100, mSolid + 40));

const desktopGradient = buildMultiStopGradient(resolvedDesktopDir, dSolid, dEnd);
const mobileGradient = buildMultiStopGradient(resolvedMobileDir, mSolid, mEnd);

const overlayId = id || `cedepro-overlay-${Math.random().toString(36).substring(2, 9)}`;
---

<div 
  id={overlayId}
  class={`cedepro-unified-overlay absolute inset-0 pointer-events-none z-[2] ${className}`}
  data-color={resolvedColor}
  data-mobile-dir={resolvedMobileDir}
  data-target-selector={targetContentSelector || ''}
  data-auto-calculate={autoCalculateCoverage ? 'true' : 'false'}
  data-buffer-px={bufferPx}
  data-fade-span={fadeSpan}
  style={`--mobile-grad: ${mobileGradient}; --desktop-grad: ${desktopGradient};`}
  aria-hidden="true"
></div>

<style>
  .cedepro-unified-overlay {
    background: var(--mobile-grad) !important;
    transition: background 0.2s ease-out;
  }
  @media (min-width: 768px) {
    .cedepro-unified-overlay {
      background: var(--desktop-grad) !important;
    }
  }
</style>

<script>
  function initDynamicOverlays() {
    const overlays = document.querySelectorAll<HTMLElement>('.cedepro-unified-overlay[data-auto-calculate="true"]');
    overlays.forEach((el) => {
      const targetSelector = el.dataset.targetSelector;
      if (!targetSelector) return;

      const parentSection = el.closest('section') || el.parentElement;
      if (!parentSection) return;

      const baseColor = el.dataset.color || '#07192F';
      const mobileDir = el.dataset.mobileDir || '180deg';
      const bufferPx = parseInt(el.dataset.bufferPx || '20', 10);
      const fadeSpan = parseInt(el.dataset.fadeSpan || '28', 10);

      function update() {
        if (!parentSection || !targetSelector) return;
        if (window.innerWidth >= 768 && window.matchMedia('(orientation: landscape)').matches) return;
        const calcFn = (window as unknown as Record<string, unknown>).cedeproCalculateContentBoundary as
          | ((section: Element, selector: string, opts: Record<string, unknown>) => { coveragePct: number; fadeEndPct: number } | null)
          | undefined;

        if (typeof calcFn === 'function') {
          const res = calcFn(parentSection, targetSelector, {
            direction: mobileDir,
            bufferPx,
            fadeSpan,
          });
          if (res) {
            const solid = res.coveragePct;
            const end = res.fadeEndPct;
            const span = end - solid;
            const p1 = Math.round(solid);
            const p2 = Math.round(solid + span * 0.20);
            const p3 = Math.round(solid + span * 0.40);
            const p4 = Math.round(solid + span * 0.62);
            const p5 = Math.round(solid + span * 0.82);
            const p6 = Math.round(end);

            const newGrad = `linear-gradient(${mobileDir}, ${baseColor} 0%, ${baseColor} ${p1}%, color-mix(in srgb, ${baseColor} 85%, transparent) ${p2}%, color-mix(in srgb, ${baseColor} 60%, transparent) ${p3}%, color-mix(in srgb, ${baseColor} 32%, transparent) ${p4}%, color-mix(in srgb, ${baseColor} 10%, transparent) ${p5}%, transparent ${p6}%)`;
            el.style.setProperty('--mobile-grad', newGrad);
          }
        }
      }

      update();

      if (window.ResizeObserver) {
        const ro = new ResizeObserver(update);
        ro.observe(parentSection);
        const target = parentSection.querySelector(targetSelector);
        if (target) ro.observe(target);
      } else {
        window.addEventListener('resize', update, { passive: true });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDynamicOverlays);
  } else {
    initDynamicOverlays();
  }

  document.addEventListener('astro:page-load', initDynamicOverlays);
</script>
