---
import HeroBadge from "../../elementos-secciones/HeroBadge.astro";
import CardProfile from "../../cards/CardProfile.astro";
import MethodologySteps from "../../elementos-secciones/MethodologySteps.astro";
import ReasonsGroup from "../../elementos-secciones/ReasonsGroup.astro";
import CardImageHorizontal from "../../cards/CardImageHorizontal.astro";
import CardNeed from "../../cards/CardNeed.astro";
import CardGrid from "../../cards/CardGrid.astro";
import CardIntegration from "../../cards/CardIntegration.astro";
import CirclesBackground from "../../elementos-secciones/CirclesBackground.astro";
import FolderTabBadge from "../../elementos-secciones/FolderTabBadge.astro";

// 1. Perfiles / Destinatarios (Sección 2)
const profiles = [
  {
    title:
      "Rectorados y promotores que necesitan dirección y control sobre sus unidades operativas para asegurar sostenibilidad institucional.",
    icon: "ion:people-outline",
    color: "#1665c0",
  },
  {
    title:
      "Vicerrectorados y decanatos que buscan articular la docencia, los posgrados y la investigación con una gestión documental clara, procesos ágiles y capacidad de respuesta a la comunidad.",
    icon: "ion:school-outline",
    color: "#00838f",
  },
  {
    title:
      "Direcciones de carrera y áreas de gestión académica que requieren ordenar su operación, procesos y evidencias con fines de acreditación y mejora continua.",
    icon: "ion:library-outline",
    color: "#5e35b1",
  },
  {
    title:
      "Universidades, institutos superiores que quieren transformar su oferta tradicional en una operación continua, moderna y rentable para competir en el nuevo contexto.",
    icon: "ion:ribbon-outline",
    color: "#df9417",
  },
  {
    title:
      "Equipos que manejan fondos o proyectos de cooperación, convenios o programas especiales y necesitan rigor y trazabilidad para rendir cuentas a escala nacional.",
    icon: "ion:briefcase-outline",
    color: "#091E3A",
  },
  {
    title:
      "Instituciones que prefieren que un especialista apoye en la operación de servicios específicos asegurando estándares con soporte técnico y sin sobrecargar a su estructura.",
    icon: "ion:shield-checkmark-outline",
    color: "#1665c0",
  },
];

// 2. Soluciones de Operación (Sección 4)
const solutions = [
  {
    title: "Gestión académica y administrativa",
    desc: "Organización de procesos clave: admisiones, registro, archivo, títulos, talento humano y servicios de soporte. Orden y eficiencia para la vida institucional.",
    icon: "ion:business-outline",
    buttonText: "Ordenar la gestión institucional",
    href: "/contactanos",
  },
  {
    title: "Operación de oferta en línea",
    desc: "Estructura operativa para programas virtuales: soporte a docentes y estudiantes, seguimiento de aulas virtuales, gestión de materiales y mesa de ayuda.",
    icon: "ion:laptop-outline",
    buttonText: "Operar mi oferta en línea",
    href: "/contactanos",
  },
  {
    title: "Educación continua y unidades",
    desc: "Modelo de operación para centros de formación continua, consultoría y servicios externos: desde el diseño de la oferta hasta la ejecución y certificación.",
    icon: "ion:school-outline",
    buttonText: "Estructurar mi unidad formativa",
    href: "/contactanos",
  },
  {
    title: "Sedes, centros y servicios",
    desc: "Despliegue operativo para nuevas sedes, centros de apoyo, laboratorios o unidades descentralizadas. Coordinación, control y estándares homogéneos.",
    icon: "ion:location-outline",
    buttonText: "Hacer funcionar una sede",
    href: "/contactanos",
  },
  {
    title: "Gestión pública e innovación",
    desc: "Soporte a proyectos del sector público y convenios con el Estado: cumplimiento normativo, gestión documental y rendición de cuentas según estándares vigentes.",
    icon: "ion:shield-checkmark-outline",
    buttonText: "Mejorar la gestión del proyecto",
    href: "/contactanos",
  },
  {
    title: "PMO y gestión de unidades",
    desc: "Oficina de gestión de proyectos para coordinar iniciativas estratégicas: seguimiento de cronogramas, presupuestos, entregables y alertas tempranas.",
    icon: "ion:pie-chart-outline",
    buttonText: "Controlar mis proyectos",
    href: "/contactanos",
  },
];

// 3. Puntos de control / Desafíos (Sección 5)
const challenges = [
  {
    label: "Transparencia y seguimiento de procesos",
    icon: "ion:eye-outline",
    color: "#00838f",
  },
  {
    label: "Eficiencia en el uso de recursos",
    icon: "ion:trending-up-outline",
    color: "#1665c0",
  },
  {
    label: "Toma de decisiones con datos reales",
    icon: "ion:bar-chart-outline",
    color: "#5e35b1",
  },
  {
    label: "Seguridad y cumplimiento institucional",
    icon: "ion:shield-checkmark-outline",
    color: "#df9417",
  },
  {
    label: "Equipos con funciones y límites claros",
    icon: "ion:people-outline",
    color: "#091E3A",
  },
  {
    label: "Satisfacción de usuarios y comunidad",
    icon: "ion:thumbs-up-outline",
    color: "#1665c0",
  },
];

// 4. Experiencias integradas (Sección 5)
const experiences = [
  {
    title: "Diagnóstico operativo",
    desc: "Análisis de flujos, cuellos de botella, cargas de trabajo y dependencias críticas. Conoce exactamente dónde están los problemas.",
    icon: "ion:search-outline",
    buttonText: "Revisar tu operación",
    href: "/contactanos",
  },
  {
    title: "Procesos y manuales",
    desc: "Documentación clara y práctica: manuales de procesos, procedimientos operativos, perfiles de puesto y matrices de responsabilidad.",
    icon: "ion:document-text-outline",
    buttonText: "Documentar procesos",
    href: "/contactanos",
  },
  {
    title: "Implementación operativa",
    desc: "Acompañamiento en el despliegue: puesta en marcha de nuevos flujos, capacitación a equipos y resolución de problemas sobre la marcha.",
    icon: "ion:construct-outline",
    buttonText: "Implementar cambios",
    href: "/contactanos",
  },
  {
    title: "Indicadores y tableros",
    desc: "Definición de KPIs operativos, diseño de tableros de control y rutinas de seguimiento para que la dirección tenga visibilidad.",
    icon: "ion:stats-chart-outline",
    buttonText: "Medir resultados",
    href: "/contactanos",
  },
  {
    title: "Gestión compartida",
    desc: "Esquema de colaboración donde asumimos temporalmente la operación de ciertas áreas mientras formamos al equipo interno.",
    icon: "ion:people-outline",
    buttonText: "Conoce esta modalidad",
    href: "/contactanos",
  },
  {
    title: "Operación de archivos",
    desc: "Organización y depuración de archivos físicos y digitales: expedientes de estudiantes, talento humano, actas institucionales y documentación legal.",
    icon: "ion:book-outline",
    buttonText: "Ordenar expedientes",
    href: "/contactanos",
  },
];

// 5. Metodología de 5 Pasos (Sección 6)
const methodologySteps = [
  {
    num: "1",
    title: "Entender",
    desc: "Identificar prioridades, cuellos de botella y flujos no medidos.",
    icon: "ion:search-outline",
  },
  {
    num: "2",
    title: "Ordenar",
    desc: "Definir procesos, roles claros y flujos de información medibles.",
    icon: "ion:document-text-outline",
  },
  {
    num: "3",
    title: "Implementar",
    desc: "Acompañar los cambios en el trabajo y no en carpetas de archivo.",
    icon: "ion:construct-outline",
  },
  {
    num: "4",
    title: "Operar",
    desc: "Garantizar control de procesos y rutinas que funcionen sin fricción.",
    icon: "ion:settings-outline",
  },
  {
    num: "5",
    title: "Mejorar",
    desc: "Revisar resultados y mejorar continuamente.",
    icon: "ion:rocket-outline",
  },
];

// 6. Por qué CEDEPRO Gestiona (Sección 7)
const reasons = [
  {
    title: "Control institucional de la operación",
    icon: "ion:settings-outline",
  },
  {
    title: "Enfoque en tu cultura interna",
    icon: "ion:bulb-outline",
  },
  {
    title: "Trazabilidad y evidencias",
    icon: "ion:document-text-outline",
  },
  {
    title: "Límites claros de responsabilidad",
    icon: "ion:git-network-outline",
  },
  {
    title: "Diseño y medición de variables",
    icon: "ion:bar-chart-outline",
  },
  {
    title: "Construcción de calidad",
    icon: "ion:shield-checkmark-outline",
  },
];
---

<div class="w-full overflow-hidden bg-white text-[#1a375b]">
  <!-- ============================================== -->
  <!-- HERO SECTION -->
  <!-- ============================================== -->
  <section
    id="hero-gestiona"
    class="relative min-h-[560px] lg:h-[calc(100vh-5rem)] lg:min-h-[560px] lg:max-h-[820px] bg-[#091E3A] flex items-center justify-center text-center px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-6 overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/portafolio/vista-formacion/sub-vista-gestiona/img-formacion-sub-gestiona-section-1-com.png"
        alt="Equipo de trabajo organizando la operación estratégica y gestión de procesos"
        class="w-full h-full object-cover object-center"
        decoding="async"
        loading="eager"
      />
      <div class="absolute inset-0 bg-slate-900/80" aria-hidden="true"></div>
    </div>

    <!-- Viñetas de Pestaña de Carpeta -->
    <FolderTabBadge orientation="horizontal" corner="top-right" color="gold" />
    <FolderTabBadge
      orientation="horizontal"
      corner="bottom-left"
      color="gold"
    />

    <div
      class="relative z-10 w-full max-w-4xl mx-auto space-y-4 sm:space-y-5 text-white pt-3 sm:pt-4"
    >
      <HeroBadge label="CEDEPRO GESTIONA" variant="ribbon" />

      <h1
        class="text-white text-3xl sm:text-5xl lg:text-[3.4rem] font-bold tracking-tight leading-[1.15] drop-shadow-md text-balance"
      >
        Convierte tu estrategia en una operación que funciona.
      </h1>

      <p
        class="text-white text-lg sm:text-2xl font-bold tracking-tight max-w-2xl mx-auto drop-shadow-sm"
      >
        Gestionar mejor para crecer con orden.
      </p>

      <p
        class="text-slate-100 text-sm sm:text-base lg:text-[16px] font-normal leading-relaxed max-w-3xl mx-auto text-balance drop-shadow-sm"
      >
        Una buena estrategia no basta si la operación no responde: procesos
        dispersos, indicadores que no se siguen, funciones poco claras y
        decisiones que se retrasan. En CEDEPRO Gestiona fortalecemos la
        operación de instituciones, proyectos y unidades para que trabajen con
        orden, información y capacidad de respuesta.
      </p>

      <div
        class="pt-3 sm:pt-4 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto"
      >
        <a
          href="#soluciones"
          class="btn-gold !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold shadow-lg w-full sm:w-auto shrink-0 text-center justify-center inline-flex items-center"
        >
          <span
            class="inline-flex items-center justify-center text-center leading-snug"
          >
            Conoce cómo gestionamos <span
              class="inline-block ml-1.5 leading-none font-bold">→</span
            >
          </span>
        </a>

        <a
          href="/contactanos"
          class="btn-outline-white !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold w-full sm:w-auto shrink-0 text-center justify-center inline-flex items-center"
        >
          <span
            class="inline-flex items-center justify-center text-center leading-snug"
          >
            Queremos ordenar la operación
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- PERFILES / DESTINATARIOS SECTION -->
  <!-- ============================================== -->
  <section
    class="relative bg-[#091E3A] px-4 py-16 sm:px-6 lg:px-8 lg:py-24 text-center overflow-hidden"
  >
    <CirclesBackground variant="navy" />
    <div class="relative z-10 mx-auto max-w-7xl space-y-12">
      <div class="mx-auto max-w-4xl space-y-3.5">
        <p class="section-eyebrow section-eyebrow--amber">
          PARA INSTITUCIONES QUE NECESITAN ORDEN ESTRATÉGICO, RESULTADOS Y
          OPERACIÓN
        </p>
        <h2
          class="text-2xl sm:text-4xl font-bold leading-tight text-white tracking-tight"
        >
          <span class="text-[#df9417]">Gestión</span> para trabajar con orden, información
          y capacidad <span class="text-[#df9417]">de respuesta</span>
        </h2>
        <p
          class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-3xl mx-auto"
        >
          En CEDEPRO Gestiona nos dirigimos a instituciones y organizaciones que
          necesitan fortalecer su modelo operativo, consolidar una unidad, poner
          en marcha una nueva línea o dotar a sus equipos de herramientas para
          sostener la operación.
        </p>
      </div>

      <CardGrid count={profiles.length}>
        {
          profiles.map((profile) => (
            <CardProfile
              title={profile.title}
              icon={profile.icon}
              color={profile.color}
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- EL RETO Y NUESTRA PROPUESTA SECTION -->
  <!-- ============================================== -->
  <section
    class="relative py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 bg-cover bg-center bg-no-repeat overflow-hidden"
  >
    <FolderTabBadge orientation="vertical" corner="top-right" color="navy" />
    <FolderTabBadge
      orientation="horizontal"
      corner="bottom-left"
      color="gold"
    />
    <div class="relative z-10 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div class="space-y-4">
          <p
            class="section-eyebrow section-eyebrow--blue font-semibold italic text-xs tracking-widest uppercase mb-2"
          >
            EL RETO
          </p>

          <h2
            class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2.2rem] font-bold leading-tight tracking-tight"
          >
            <span class="text-[#df9417]">Una estrategia</span> puede estar bien pensada
            y aun así no funcionar en la operación
          </h2>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            Muchas instituciones y proyectos tienen claras sus metas, pero
            encuentran dificultades al momento de ejecutarlas: procesos
            documentados que nadie aplica, información dispersa, duplicidad de
            esfuerzos, equipos desconectados y decisiones que dependen siempre
            de las mismas personas.
          </p>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            La falta de orden operativo no solo genera ineficiencias y
            sobrecostos: desgasta a los equipos, debilita la calidad del
            servicio, expone a riesgos de cumplimiento y resta capacidad para
            aprovechar nuevas oportunidades.
          </p>

          <div class="pt-3">
            <a
              href="#soluciones"
              class="btn-navy w-full sm:w-auto justify-center !rounded-full !px-7 !py-3 !text-sm !font-bold shadow-md inline-flex items-center"
            >
              <span
                class="inline-flex items-center justify-center text-center leading-snug"
              >
                Identifica tu reto operativo <span
                  class="inline-block ml-2 font-bold">→</span
                >
              </span>
            </a>
          </div>
        </div>

        <div
          class="space-y-4 md:pl-10 lg:pl-12 md:border-l-2 md:border-[#1a375b]"
        >
          <p
            class="section-eyebrow section-eyebrow--blue font-semibold italic text-xs tracking-widest uppercase mb-2"
          >
            NUESTRA PROPUESTA
          </p>

          <h2
            class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2.2rem] font-bold leading-tight tracking-tight"
          >
            <span class="text-[#df9417]">Del plan a la operación</span> con responsables,
            indicadores y control
          </h2>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            En CEDEPRO Gestiona ayudamos a convertir las intenciones
            estratégicas en una operación ordenada, medible y sostenible. No nos
            limitamos a diagnosticar: diseñamos la ruta de acción, estructuramos
            los procesos, capacitamos a los equipos y acompañamos la
            implementación.
          </p>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            Trabajamos sobre lo que existe para fortalecerlo: revisamos la
            estructura, simplificamos los flujos, organizamos la información y
            dejamos herramientas para que la institución pueda operar de forma
            autónoma.
          </p>

          <div class="pt-3">
            <a
              href="/contactanos"
              class="w-full sm:w-auto text-center inline-block bg-white/0 border-2 border-[#1a375b] text-[#1a375b] hover:bg-[#1a375b] hover:text-white transition-colors px-5 sm:px-6 py-2.5 rounded-full text-xs sm:text-sm font-bold shadow-sm italic"
            >
              Hablemos de cómo organizar tu operación
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- SOLUCIONES DE OPERACIÓN SECTION -->
  <!-- ============================================== -->
  <section
    id="soluciones"
    class="relative bg-[#df9417] py-16 sm:py-20 px-4 sm:px-6 lg:px-8 text-white overflow-hidden"
  >
    <CirclesBackground variant="gold" />
    <div class="relative z-10 max-w-7xl mx-auto space-y-10">
      <div class="text-left sm:text-center space-y-2">
        <p class="section-eyebrow section-eyebrow--white">
          UNA SOLUCIÓN PARA CADA DIMENSIÓN DE LA OPERACIÓN
        </p>
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-white">
          Gestionamos lo que tu institución necesita hacer funcionar
        </h2>
      </div>

      <CardGrid count={solutions.length}>
        {
          solutions.map((route) => (
            <CardImageHorizontal
              title={route.title}
              description={route.desc}
              icon={route.icon}
              iconBgColor="#df9417"
              iconLayout="col"
              buttonText={`${route.buttonText} →`}
              buttonHref={route.href}
              buttonClass="btn-outline-gold !w-full !rounded-full !py-2.5 !px-4 !text-xs sm:!text-[13px] !font-bold text-center justify-center inline-flex items-center"
              class="w-full h-full shadow-lg bg-white"
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- EXPERIENCIAS INTEGRADAS SECTION -->
  <!-- ============================================== -->
  <section
    id="experiencias"
    class="relative bg-[#091E3A] px-4 py-14 sm:px-6 lg:px-8 lg:py-16 overflow-hidden"
  >
    <CirclesBackground variant="navy" />
    <div class="relative z-10 mx-auto max-w-7xl space-y-8">
      <div class="text-center space-y-1.5 w-full mx-auto text-white">
        <p class="section-eyebrow section-eyebrow--gold">
          DIEZ LÍNEAS CONCRETAS DE NUESTRO SERVICIO
        </p>
        <h2
          class="text-2xl sm:text-3xl md:text-[2rem] lg:text-[2.2rem] xl:text-[2.4rem] font-bold tracking-tight drop-shadow-sm text-balance"
        >
          De la desorganización a un modelo de trabajo que <span
            class="text-[#df9417]">se puede controlar</span
          >
        </h2>
        <p
          class="text-white/95 text-[14px] sm:text-[15px] italic leading-relaxed pt-1 max-w-4xl mx-auto"
        >
          La falta de procedimiento claro, la sobrecarga operativa y la
          dispersión de responsabilidades limitan la capacidad de crecer. En
          CEDEPRO Gestiona aportamos método, herramientas y acompañamiento para
          construir una operación que funcione.
        </p>
      </div>

      <CardGrid count={challenges.length} maxWidth="64rem">
        {
          challenges.map((need) => (
            <CardNeed label={need.label} icon={need.icon} color={need.color} />
          ))
        }
      </CardGrid>

      <div
        class="inline-block rounded-md bg-[#df9417] px-4 py-2 text-lg font-bold text-white"
      >
        Experiencias que pueden integrarse
      </div>

      <CardGrid count={experiences.length}>
        {
          experiences.map((exp) => (
            <CardIntegration
              title={exp.title}
              desc={exp.desc}
              icon={exp.icon}
              iconColor="#1665c0"
              buttonText={`${exp.buttonText} →`}
              buttonHref={exp.href}
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- METODOLOGÍA Y POR QUÉ ELEGIRNOS SECTION -->
  <!-- ============================================== -->
  <section id="metodologia">
    <div
      class="relative bg-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 overflow-hidden"
    >
      <!-- Viñeta Superior Derecha (Vertical Azul Marino) -->
      <FolderTabBadge orientation="vertical" corner="top-right" color="navy" />

      <div class="max-w-6xl mx-auto space-y-8 relative z-10">
        <div class="space-y-1.5 text-left">
          <p
            class="section-eyebrow section-eyebrow--gold font-bold tracking-[0.15em] uppercase text-xs sm:text-sm"
          >
            NUESTRA METODOLOGÍA
          </p>
          <h2
            class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2.2rem] font-bold tracking-tight leading-tight"
          >
            La gestión no se limita a entregar un documento.
          </h2>
        </div>
        <MethodologySteps items={methodologySteps} theme="light" />
      </div>

      <!-- Viñeta Inferior Izquierda (Horizontal Dorada) -->
      <FolderTabBadge
        orientation="horizontal"
        corner="bottom-left"
        color="gold"
      />
    </div>

    <div
      class="relative bg-[#df9417] py-10 sm:py-12 px-4 sm:px-6 lg:px-8 overflow-hidden text-white"
    >
      <CirclesBackground variant="gold" />
      <div class="max-w-7xl mx-auto space-y-6 relative z-10">
        <div class="space-y-1 text-left">
          <p
            class="text-white/90 text-xs sm:text-[13px] font-semibold italic tracking-wider uppercase"
          >
            POR QUÉ CEDEPRO GESTIONA
          </p>
          <h2
            class="text-white text-2xl sm:text-3xl lg:text-[2.1rem] font-bold tracking-tight leading-tight"
          >
            Gestión que conecta estrategia, operación y resultados
          </h2>
        </div>
        <ReasonsGroup
          items={reasons}
          variant="navy-on-gold"
          layout="flex"
          dividerColorClass="divide-[#091E3A]/30"
        />
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- CALL TO ACTION SECTION -->
  <!-- ============================================== -->
  <section
