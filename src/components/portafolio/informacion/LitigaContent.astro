---
import HeroBadge from "../../HeroBadge.astro";
import CardProfile from "../../cards/CardProfile.astro";
import MethodologySteps from "../../cards/MethodologySteps.astro";
import ReasonsGroup from "../../cards/ReasonsGroup.astro";
import CardImageHorizontal from "../../cards/CardImageHorizontal.astro";
import CardNeed from "../../cards/CardNeed.astro";
import CardGrid from "../../cards/CardGrid.astro";
import CardIntegration from "../../cards/CardIntegration.astro";
import CirclesBackground from "../CirclesBackground.astro";
import FolderTabBadge from "../FolderTabBadge.astro";

const profiles = [
  {
    title:
      "Abogados en libre ejercicio, asesores jurídicos, procuradores y consultores que desean fortalecer su práctica.",
    icon: "ion:scale-outline",
    color: "#1665c0",
  },
  {
    title:
      "Universidades, colegios profesionales, entidades públicas, gobiernos autónomos descentralizados y organismos de justicia que buscan programas para sus comunidades.",
    icon: "ion:business-outline",
    color: "#00838f",
  },
  {
    title:
      "Jueces, fiscales, defensores públicos, secretarios, ayudantes judiciales y otros operadores de justicia.",
    icon: "ion:hammer-outline",
    color: "#5e35b1",
  },
  {
    title:
      "Docentes, investigadores y estudiantes de los últimos niveles de las carreras de Derecho.",
    icon: "ion:document-text-outline",
    color: "#df9417",
  },
  {
    title:
      "Estudios jurídicos, empresas y equipos legales corporativos que requieren formación especializada para sus equipos.",
    icon: "ion:people-outline",
    color: "#091E3A",
  },
  {
    title:
      "Servidores públicos y equipos responsables de contratación, asesoría, cumplimiento y gestión jurídica.",
    icon: "ion:briefcase-outline",
    color: "#1665c0",
  },
];

const routes = [
  {
    title: "Carrera judicial y concursos",
    desc: "Fortalece competencias para concursos, razonamiento jurídico y preparación profesional en carrera judicial.",
    icon: "ion:book-outline",
    buttonText: "Prepararme para la carrera judicial",
    href: "/contactanos",
  },
  {
    title: "Litigación y Oralidad",
    desc: "Desarrolla estrategias procesales, argumentación oral y habilidades para audiencias efectivas.",
    icon: "ion:scale-outline",
    buttonText: "Fortalecer mi litigación",
    href: "/contactanos",
  },
  {
    title: "Argumentación y decisión",
    desc: "Mejora análisis jurídico, interpretación normativa y fundamentación sólida de decisiones profesionales.",
    icon: "ion:document-text-outline",
    buttonText: "Mejorar mi argumentación",
    href: "/contactanos",
  },
  {
    title: "Derecho público y contratación",
    desc: "Actualiza conocimientos en gestión pública, contratación estatal y cumplimiento jurídico responsable.",
    icon: "ion:people-outline",
    buttonText: "Actualizarme en gestión jurídica",
    href: "/contactanos",
  },
  {
    title: "Operación jurídica y judicial",
    desc: "Optimiza gestión documental, procesos judiciales y organización eficiente de la práctica jurídica.",
    icon: "ion:business-outline",
    buttonText: "Ordenar mi práctica jurídica",
    href: "/contactanos",
  },
  {
    title: "Justicia digital e IA",
    desc: "Integra tecnología jurídica, inteligencia artificial y herramientas digitales para transformación profesional.",
    icon: "ion:hammer-outline",
    buttonText: "Explorar la transformación jurídica",
    href: "/contactanos",
  },
];

const challenges = [
  {
    label: "Necesitas prepararte para un concurso",
    icon: "ion:school-outline",
    color: "#00838f",
  },
  {
    label: "Quieres fortalecer tu litigación",
    icon: "ion:bar-chart-outline",
    color: "#1665c0",
  },
  {
    label: "Debes escribir mejor",
    icon: "ion:document-text-outline",
    color: "#5e35b1",
  },
  {
    label: "Gestionas contratación pública",
    icon: "ion:people-outline",
    color: "#df9417",
  },
  {
    label: "Quieres comprender la prueba",
    icon: "ion:search-outline",
    color: "#091E3A",
  },
  {
    label: "Tu equipo necesita una ruta",
    icon: "ion:trending-up-outline",
    color: "#1665c0",
  },
];

const experiences = [
  {
    title: "Webinars y seminarios",
    desc: "Espacios introductorios para conocer tendencias jurídicas y oportunidades de aprendizaje.",
    icon: "ion:videocam-outline",
    buttonText: "Ver próximos eventos",
    href: "/contactanos",
  },
  {
    title: "Cursos y talleres",
    desc: "Formación práctica enfocada en competencias jurídicas aplicables profesionalmente.",
    icon: "ion:briefcase-outline",
    buttonText: "Explorar cursos",
    href: "/contactanos",
  },
  {
    title: "Bootcamps y clínicas",
    desc: "Entrenamiento intensivo mediante casos, práctica y retroalimentación especializada.",
    icon: "ion:laptop-outline",
    buttonText: "Practicar con acompañamiento",
    href: "/contactanos",
  },
  {
    title: "Microcredenciales",
    desc: "Reconocimientos formativos que validan avances y competencias jurídicas específicas.",
    icon: "ion:ribbon-outline",
    buttonText: "Conocer las rutas",
    href: "/contactanos",
  },
  {
    title: "Certificaciones y diplomados",
    desc: "Programas profundos que fortalecen conocimientos y trayectoria profesional jurídica.",
    icon: "ion:document-text-outline",
    buttonText: "Solicitar información",
    href: "/contactanos",
  },
  {
    title: "Academias institucionales",
    desc: "Formación personalizada para universidades, entidades y equipos jurídicos especializados.",
    icon: "ion:bar-chart-outline",
    buttonText: "Formar a mi equipo",
    href: "/contactanos",
  },
];

const methodologySteps = [
  {
    num: "1",
    title: "Comprender",
    desc: "Interpretar fundamentos jurídicos para entender casos.",
    icon: "ion:settings-outline",
  },
  {
    num: "2",
    title: "Analizar",
    desc: "Examinar hechos, pruebas y alternativas jurídicas.",
    icon: "ion:bulb-outline",
  },
  {
    num: "3",
    title: "Construir",
    desc: "Crear argumentos, estrategias y documentos procesales.",
    icon: "ion:construct-outline",
  },
  {
    num: "4",
    title: "Simular",
    desc: "Practicar audiencias y decisiones jurídicas aplicadas.",
    icon: "ion:settings-outline",
  },
  {
    num: "5",
    title: "Demostrar",
    desc: "Evidenciar aprendizajes mediante productos jurídicos concretos.",
    icon: "ion:rocket-outline",
  },
];

const reasons = [
  {
    title: "Práctica vinculada con el ejercicio profesional",
    icon: "ion:people-outline",
  },
  {
    title: "Actualización frente al cambio",
    icon: "ion:document-text-outline",
  },
  {
    title: "Tecnología aplicada con criterio",
    icon: "ion:bar-chart-outline",
  },
  {
    title: "Ética y responsabilidad",
    icon: "ion:heart-outline",
  },
  {
    title: "Respaldo de CEDEPRO Formación",
    icon: "ion:school-outline",
  },
  {
    title: "Especialización por rutas",
    icon: "ion:location-outline",
  },
];
---

<div class="w-full overflow-hidden bg-white text-[#1a375b]">
  <!-- ============================================== -->
  <!-- HERO SECTION -->
  <!-- ============================================== -->
  <section
    id="hero-litiga"
    class="relative min-h-[560px] lg:h-[calc(100vh-5rem)] lg:min-h-[560px] lg:max-h-[820px] bg-[#091E3A] flex items-center justify-center text-center px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-6 overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <img
        src="/assets/portafolio/vista-informacion/sub-vista-litiga/img-informacion-sub-impulsa-section-1-com.png"
        alt="Balanza de justicia, libros jurídicos y edificios judiciales"
        class="w-full h-full object-cover object-center"
        decoding="async"
        loading="eager"
      />
      <div class="absolute inset-0 bg-slate-900/80" aria-hidden="true"></div>
    </div>
    <!-- Viñetas de Pestaña de Carpeta -->
    <FolderTabBadge orientation="horizontal" corner="top-right" color="gold" />
    <FolderTabBadge
      orientation="horizontal"
      corner="bottom-left"
      color="gold"
    />
    <div
      class="relative z-10 max-w-4xl mx-auto space-y-4 sm:space-y-5 text-white pt-3 sm:pt-4"
    >
      <HeroBadge label="LITIGA" variant="ribbon" />
      <h1
        class="text-white text-3xl sm:text-5xl lg:text-[3.4rem] font-bold tracking-tight leading-[1.15] drop-shadow-md text-balance"
      >
        Del conocimiento jurídico a la acción fundamentada.
      </h1>
      <p
        class="text-white text-lg sm:text-2xl font-bold tracking-tight max-w-2xl mx-auto drop-shadow-sm"
      >
        Aprende Derecho para argumentar, decidir y actuar.
      </p>
      <p
        class="text-slate-100 text-sm sm:text-base lg:text-[16px] font-normal leading-relaxed max-w-3xl mx-auto text-balance drop-shadow-sm"
      >
        Fortalece tus competencias jurídicas con formación práctica en
        litigación, argumentación, carrera judicial, contratación pública,
        operación jurídica, justicia digital e inteligencia artificial aplicada
        al Derecho. Aprende con casos, documentos, simulaciones y
        retroalimentación para actuar con mayor claridad y responsabilidad.
      </p>
      <div
        class="pt-3 sm:pt-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto"
      >
        <a
          href="#rutas"
          class="btn-gold !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold shadow-lg w-full sm:w-auto text-center justify-center inline-flex items-center !leading-none"
        >
          <span
            class="inline-flex items-center justify-center text-center leading-none -translate-y-[1.5px]"
          >
            Encuentra tu ruta jurídica <span
              class="inline-block ml-1.5 leading-none font-bold">→</span
            >
          </span>
        </a>

        <a
          href="/contactanos"
          class="btn-outline-white !rounded-full !px-6 sm:!px-7 !py-3 !text-sm sm:!text-[15px] !font-bold w-full sm:w-auto text-center justify-center inline-flex items-center !leading-none"
        >
          <span
            class="inline-flex items-center justify-center text-center leading-none -translate-y-[1.5px]"
          >
            Solicita información
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- PERFILES SECTION -->
  <!-- ============================================== -->
  <section
    class="relative bg-[#091E3A] px-4 py-16 sm:px-6 lg:px-8 lg:py-24 text-center overflow-hidden"
  >
    <CirclesBackground variant="navy" />
    <div class="relative z-10 mx-auto max-w-7xl space-y-12">
      <div class="mx-auto max-w-4xl space-y-3.5">
        <p class="section-eyebrow section-eyebrow--amber">
          PARA QUIENES NECESITAN CONVERTIR CONOCIMIENTO JURÍDICO EN CAPACIDAD DE
          ACTUACIÓN
        </p>
        <h2
          class="text-2xl sm:text-4xl font-bold leading-tight text-white tracking-tight"
        >
          <span class="text-[#df9417]">Formación para el Derecho</span> que se ejerce,
          se decide y se transforma
        </h2>
        <p
          class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-3xl mx-auto"
        >
          CEDEPRO LITIGA está dirigida a personas y organizaciones que necesitan
          actualizarse, practicar habilidades jurídicas y responder a los
          cambios normativos, institucionales y tecnológicos que impactan el
          ejercicio profesional y la administración de justicia.
        </p>
      </div>

      <CardGrid count={profiles.length}>
        {
          profiles.map((profile) => (
            <CardProfile
              title={profile.title}
              icon={profile.icon}
              color={profile.color}
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- EL RETO Y NUESTRA RESPUESTA SECTION -->
  <!-- ============================================== -->
  <section
    class="relative py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 bg-cover bg-center bg-no-repeat overflow-hidden"
    style="background-image: url('/assets/portafolio/vista-informacion/sub-vista-litiga/img-informacion-sub-impulsa-section-3-com.png');"
  >
    <div class="absolute inset-0 bg-white/80 pointer-events-none"></div>
    <FolderTabBadge orientation="vertical" corner="top-right" color="navy" />
    <FolderTabBadge
      orientation="horizontal"
      corner="bottom-left"
      color="gold"
    />
    <div class="relative z-10 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div class="space-y-4">
          <p
            class="section-eyebrow section-eyebrow--blue font-semibold italic text-xs tracking-widest uppercase mb-2"
          >
            EL RETO
          </p>

          <h2
            class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2.2rem] font-bold leading-tight tracking-tight"
          >
            El <span class="text-[#df9417]">conocimiento jurídico</span> no puede
            quedarse en la teoría
          </h2>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            Las normas cambian, los procesos se vuelven más complejos y la
            práctica jurídica exige mucho más que memorizar conceptos. Analizar
            un expediente, valorar una prueba, construir una teoría del caso,
            redactar un escrito o preparar una audiencia requiere criterio,
            método y entrenamiento.
          </p>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            Cuando la formación no se conecta con situaciones reales, aparecen
            inseguridad, respuestas poco estructuradas y dificultad para
            trasladar la norma a una actuación concreta. El desafío es aprender
            a interpretar, argumentar, decidir y actuar con fundamento.
          </p>

          <div class="pt-3">
            <a
              href="/contactanos"
              class="btn-navy !rounded-full !px-7 !py-3 !text-sm !font-bold shadow-md inline-flex items-center"
            >
              <span
                class="inline-flex items-center justify-center text-center leading-none -translate-y-[1.5px]"
              >
                Identifica tu desafío jurídico <span
                  class="inline-block ml-2 font-bold">→</span
                >
              </span>
            </a>
          </div>
        </div>
        <div
          class="space-y-4 md:pl-10 lg:pl-12 md:border-l-2 md:border-[#1a375b]"
        >
          <p
            class="section-eyebrow section-eyebrow--blue font-semibold italic text-xs tracking-widest uppercase mb-2"
          >
            NUESTRA RESPUESTA
          </p>

          <h2
            class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2.2rem] font-bold leading-tight tracking-tight"
          >
            <span class="text-[#df9417]">Formación jurídica</span> que se entrena
            con casos, argumentos y decisiones
          </h2>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            CEDEPRO Litiga organiza experiencias de aprendizaje que conectan la
            norma con la práctica profesional. Cada ruta puede combinar
            contenidos, análisis jurisprudencial, expedientes, ejercicios de
            redacción, simulaciones procesales, audiencias demostrativas,
            debates, revisión entre pares y retroalimentación.
          </p>

          <p
            class="text-slate-700 text-sm sm:text-[14.5px] font-normal leading-relaxed"
          >
            El objetivo no es ofrecer información aislada, sino ayudar a que
            cada participante produzca evidencias de aprendizaje: escritos,
            dictámenes, alegatos, teorías del caso, estrategias procesales,
            decisiones motivadas, documentos contractuales o soluciones para la
            gestión jurídica.
          </p>

          <div class="pt-3">
            <div
              class="inline-block bg-white/0 border-2 border-[#1a375b] text-[#1a375b] px-5 sm:px-6 py-2.5 rounded-full text-xs sm:text-sm font-bold shadow-sm italic"
            >
              Aprende a actuar con mayor criterio y preparación
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- RUTAS JURÍDICAS SECTION -->
  <!-- ============================================== -->
  <section
    id="rutas"
    class="relative bg-[#df9417] py-16 sm:py-20 px-4 sm:px-6 lg:px-8 text-white overflow-hidden"
  >
    <CirclesBackground variant="gold" />
    <div class="relative z-10 max-w-7xl mx-auto space-y-10">
      <div class="text-left sm:text-center space-y-2">
        <p class="section-eyebrow section-eyebrow--white">
          UNA RUTA JURÍDICA PARA CADA DESAFÍO PROFESIONAL
        </p>
        <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-white">
          Elige el ámbito que quieres fortalecer
        </h2>
      </div>
      <CardGrid count={routes.length}>
        {
          routes.map((route) => (
            <CardImageHorizontal
              title={route.title}
              description={route.desc}
              icon={route.icon}
              iconBgColor="#df9417"
              iconLayout="col"
              buttonText={`${route.buttonText} →`}
              buttonHref={route.href}
              buttonClass="btn-outline-gold !w-full !rounded-xl !py-2.5 !px-3 !text-xs !font-bold text-center justify-center inline-flex items-center"
              class="w-full h-full shadow-lg bg-white"
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- EXPERIENCIAS INTEGRADAS SECTION -->
  <!-- ============================================== -->
  <section
    id="experiencias"
    class="relative bg-[#091E3A] px-4 py-14 sm:px-6 lg:px-8 lg:py-16 overflow-hidden"
  >
    <CirclesBackground variant="navy" />
    <div class="relative z-10 mx-auto max-w-7xl space-y-8">
      <div class="text-center space-y-1.5 w-full mx-auto text-white">
        <p class="section-eyebrow section-eyebrow--gold">
          QUÉ PUEDES ENCONTRAR EN CEDEPRO LITIGA
        </p>
        <h2
          class="text-2xl sm:text-3xl md:text-[2rem] lg:text-[2.2rem] xl:text-[2.4rem] font-bold tracking-tight drop-shadow-sm text-balance"
        >
          Del desafío jurídico a una experiencia que puedes aplicar
        </h2>
        <p class="text-sm text-slate-300">Tu equipo necesita una ruta.</p>
        <p
          class="text-white/95 text-[14px] sm:text-[15px] italic leading-relaxed pt-1 max-w-4xl mx-auto"
        >
          La solución depende del objetivo de aprendizaje, el perfil del
          participante y el nivel de profundidad requerido. Algunas experiencias
          pueden ser breves y específicas; otras pueden organizarse como rutas
          progresivas o programas para equipos.
        </p>
      </div>

      <CardGrid count={challenges.length} maxWidth="64rem">
        {
          challenges.map((need) => (
            <CardNeed label={need.label} icon={need.icon} color={need.color} />
          ))
        }
      </CardGrid>

      <div
        class="inline-block rounded-md bg-[#df9417] px-4 py-2 text-lg font-bold text-white"
      >
        Experiencias que pueden integrarse
      </div>

      <CardGrid count={experiences.length}>
        {
          experiences.map((exp) => (
            <CardIntegration
              title={exp.title}
              desc={exp.desc}
              icon={exp.icon}
              iconColor="#1665c0"
              buttonText={`${exp.buttonText} →`}
              buttonHref={exp.href}
            />
          ))
        }
      </CardGrid>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- METODOLOGÍA Y POR QUÉ ELEGIRNOS SECTION -->
  <!-- ============================================== -->
  <section id="metodologia">
    <div
      class="relative bg-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 overflow-hidden"
    >
      <!-- Viñeta Superior Derecha (Vertical Azul Marino) -->
      <FolderTabBadge orientation="vertical" corner="top-right" color="navy" />

      <div class="max-w-6xl mx-auto space-y-8 relative z-10">
        <div class="space-y-1.5 text-left">
          <p
            class="section-eyebrow section-eyebrow--gold font-bold tracking-[0.15em] uppercase text-xs sm:text-sm"
          >
            NUESTRA METODOLOGÍA
          </p>
          <h2
            class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2.2rem] font-bold tracking-tight leading-tight"
          >
            Comprende la norma. Entrena el criterio. <span
              class="text-[#df9417]">Actúa con fundamento</span
            >
          </h2>
        </div>
        <MethodologySteps items={methodologySteps} theme="light" />
      </div>

      <!-- Viñeta Inferior Izquierda (Horizontal Dorada) -->
      <FolderTabBadge
        orientation="horizontal"
        corner="bottom-left"
        color="gold"
      />
    </div>
    <div
      class="relative bg-[#df9417] py-10 sm:py-12 px-4 sm:px-6 lg:px-8 overflow-hidden text-white"
    >
      <CirclesBackground variant="gold" />
      <div class="max-w-7xl mx-auto space-y-6 relative z-10">
        <div class="space-y-1 text-left">
          <p
            class="text-white/90 text-xs sm:text-[13px] font-semibold italic tracking-wider uppercase"
          >
            POR QUÉ CEDEPRO LITIGA
          </p>
          <h2
            class="text-white text-2xl sm:text-3xl lg:text-[2.1rem] font-bold tracking-tight leading-tight"
          >
            Formación jurídica orientada a la acción.
          </h2>
        </div>
        <ReasonsGroup
          items={reasons}
          variant="navy-on-gold"
          layout="flex"
          dividerColorClass="divide-[#091E3A]/30"
        />
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- CALL TO ACTION SECTION -->
  <!-- ============================================== -->
  <section
    class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 text-white overflow-hidden bg-[#07192F]"
  >
    <div class="absolute inset-0 z-0">
      <picture>
        <source
          srcset="/assets/nosotros/img-nosotros-section-9.webp"
          type="image/webp"
        />
        <img
          src="/assets/nosotros/img-nosotros-section-9.webp"
          alt="Consultores trabajando en reunión estratégica nocturna"
          class="w-full h-full object-cover object-right sm:object-center"
          width="1920"
          height="1080"
          decoding="async"
          loading="lazy"
        />
      </picture>
    </div>

    <!-- FILTRO AZUL TRANSLÚCIDO NITIDO (SIN BLUR) -->
    <div class="absolute inset-0 bg-[#091E3A]/70 z-10 pointer-events-none">
    </div>

    <div class="relative z-10 mx-auto max-w-7xl">
