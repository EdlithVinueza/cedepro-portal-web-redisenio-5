---
import { Icon } from 'astro-icon/components';

const profiles = [
  { title: 'Rectores, promotores y autoridades que impulsan mejoras institucionales.', icon: 'ion:business-outline', color: '#091E3A' },
  { title: 'Equipos administrativos de calidad, bienestar, planificación y gestión institucional.', icon: 'ion:people-outline', color: '#00838f' },
  { title: 'Docentes y responsables académicos que necesitan actualizar sus prácticas y recursos.', icon: 'ion:stats-chart-outline', color: '#1665c0' },
  { title: 'Instituciones que requieren programas presenciales, virtuales o híbridos.', icon: 'ion:bulb-outline', color: '#5e35b1' },
  { title: 'Organizaciones que buscan rutas formativas y microcredenciales para sus equipos.', icon: 'ion:document-text-outline', color: '#df9417' }
];

const needs = [
  { label: 'Tu equipo necesita actualizarse', icon: 'ion:arrow-up-circle-outline', color: '#091E3A' },
  { label: 'Quieres fortalecer la práctica docente', icon: 'ion:stats-chart-outline', color: '#1665c0' },
  { label: 'Necesitas capacitación institucional', icon: 'ion:document-text-outline', color: '#00838f' },
  { label: 'Buscas una ruta más flexible', icon: 'ion:people-outline', color: '#1976d2' },
  { label: 'Quieres que la formación se sostenga', icon: 'ion:search-outline', color: '#5e35b1' }
];

const solutions = [
  { title: 'Programas de capacitación institucional', desc: 'Formación estratégica para equipos y organizaciones.', icon: 'ion:business-outline' },
  { title: 'Cursos especializados y actualización', desc: 'Conocimiento práctico para retos profesionales actuales.', icon: 'ion:settings-outline' },
  { title: 'Microcredenciales y rutas formativas', desc: 'Aprendizajes progresivos que impulsan el desarrollo profesional.', icon: 'ion:document-text-outline' },
  { title: 'AWLA Formación Continua', desc: 'Una plataforma inteligente para formación efectiva.', icon: 'ion:bar-chart-outline' }
];

const steps = [
  { num: '1', title: 'Comprender', desc: 'Entendemos las necesidades para crear formación efectiva.', icon: 'ion:search-outline' },
  { num: '2', title: 'Diseñar', desc: 'Construimos programas adaptados a cada desafío.', icon: 'ion:construct-outline' },
  { num: '3', title: 'Aplicar', desc: 'Impulsamos aprendizaje práctico orientado a resultados.', icon: 'ion:document-outline' },
  { num: '4', title: 'Escalar', desc: 'Multiplicamos el alcance con soluciones digitales innovadoras.', icon: 'ion:bulb-outline' },
  { num: '5', title: 'Acompañar', desc: 'Aseguramos implementación, seguimiento y mejora permanente.', icon: 'ion:people-outline' }
];
---

<section class="relative overflow-hidden bg-[#091E3A] text-white">
  <div class="absolute inset-0"><img src="/assets/portafolio/vista-proyectos/img-portafolio-proyectos-section-1.png" alt="Equipo en una sesión de formación" class="h-full w-full object-cover object-left opacity-75" /><div class="absolute inset-0 bg-gradient-to-r from-[#091E3A]/20 via-[#091E3A]/85 to-[#091E3A]"></div></div>
  <div class="relative z-10 mx-auto flex min-h-[31rem] max-w-7xl items-center justify-end px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-xl space-y-4"><p class="text-xs uppercase italic tracking-[0.15em] text-[#df9417]">CEDEPRO FORMACIÓN</p><h1 class="text-3xl font-bold leading-[1.05] sm:text-4xl lg:text-[2.65rem]">El conocimiento que no se aplica no transforma.</h1><p class="text-base font-bold leading-tight">Forma equipos que hagan avanzar a tu institución.</p><p class="text-sm leading-relaxed text-slate-100">Diseñamos experiencias de aprendizaje prácticas, actuales y conectadas con los desafíos de la educación superior. Fortalecemos las capacidades de docentes, directivos y equipos de trabajo para que lo aprendido se convierta en mejores decisiones, mejores prácticas y resultados sostenibles.</p><div class="flex flex-col gap-3 pt-3 sm:flex-row"><a href="#soluciones" class="btn-gold inline-flex justify-center px-6 py-3 text-sm font-bold"><span>Conoce nuestra propuesta formativa <span class="ml-1">→</span></span></a><a href="/contactanos" class="btn-outline-white inline-flex justify-center px-6 py-3 text-sm font-bold"><span>Diseña una ruta para tu equipo</span></a></div></div>
  </div>
</section>

<section class="bg-white px-4 py-14 text-center sm:px-6 lg:px-8 lg:py-20"><div class="mx-auto max-w-7xl space-y-10"><div class="mx-auto max-w-4xl space-y-3"><p class="text-xs uppercase italic tracking-[0.15em] text-[#1a375b]">PARA QUIENES NECESITAN CONVERTIR APRENDIZAJE EN DESEMPEÑO</p><h2 class="text-2xl font-bold leading-tight text-[#1a375b] sm:text-3xl">La formación que responde a los <span class="text-[#df9417]">retos reales</span> de tu equipo</h2><p class="text-[15px] leading-relaxed text-[#1a375b]">CEDEPRO Formación está dirigida a instituciones, organizaciones y equipos que necesitan actualizar conocimientos, fortalecer competencias y mejorar la manera en que trabajan.</p></div><div class="flex flex-wrap justify-center gap-4">{profiles.map((profile) => <div class="card-profile w-full max-w-[19rem]"><div class="card-icon-circle" style={`background-color:${profile.color}`}><Icon name={profile.icon} class="h-7 w-7 text-white stroke-1" /></div><div><p class="text-xs font-bold leading-tight text-[#1a375b]">{profile.title}</p><span class="card-category-bar" style={`background-color:${profile.color}`}></span></div></div>)}</div></div></section>

<section class="bg-[#091E3A] px-4 py-14 text-white sm:px-6 lg:px-8 lg:py-16"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2"><div class="space-y-4 lg:pr-10"><p class="text-xs uppercase italic tracking-[0.15em] text-[#df9417]">EL RETO</p><h2 class="text-2xl font-bold leading-tight sm:text-3xl">Capacitar no es suficiente si el aprendizaje no cambia la forma de trabajar</h2><p class="text-sm leading-relaxed text-slate-200">Muchas instituciones invierten en cursos que no se conectan con sus problemas, no generan prácticas nuevas o no dejan capacidades instaladas. El desafío está en diseñar formación relevante, aplicable y conectada con la operación real.</p><a href="#metodologia" class="btn-gold inline-flex px-5 py-2.5 text-sm font-bold"><span>Identifica la necesidad de tu equipo <span class="ml-1">→</span></span></a></div><div class="space-y-4 border-white/20 lg:border-l lg:pl-10"><p class="text-xs uppercase italic tracking-[0.15em] text-[#df9417]">NUESTRA RESPUESTA</p><h2 class="text-2xl font-bold leading-tight sm:text-3xl">Capacidades que se convierten en <span class="text-[#df9417]">resultados</span></h2><p class="text-sm leading-relaxed text-slate-200">Partimos de los desafíos y objetivos de la institución para diseñar experiencias formativas que combinen contenido actual, práctica, acompañamiento y recursos digitales.</p><div class="inline-block rounded bg-white px-4 py-2 text-sm font-bold italic text-[#1a375b]">Formación eficaz para capacitar y avanzar.</div></div></div></section>

<section class="bg-white px-4 py-14 sm:px-6 lg:px-8 lg:py-20"><div class="mx-auto max-w-7xl space-y-10"><div><p class="text-xs uppercase italic tracking-[0.15em] text-[#1a375b]">UNA LÍNEA PARA CADA DESAFÍO</p><h2 class="text-2xl font-bold text-[#1a375b] sm:text-3xl">Elige el tipo de <span class="text-[#df9417]">aprendizaje</span> que tu reto necesita</h2></div><div class="grid gap-5 md:grid-cols-3">{solutions.slice(0, 3).map((solution) => <article class="card-integration flex-col"><div class="flex items-center gap-3"><div class="card-icon-circle h-11 w-11 bg-[#1665c0]"><Icon name={solution.icon} class="h-6 w-6 text-white stroke-1" /></div><h3 class="text-base font-bold leading-tight text-[#1a375b]">{solution.title}</h3></div><p class="text-sm leading-relaxed text-[#1a375b]/80">{solution.desc}</p><a href="/contactanos" class="btn-outline-gold inline-flex self-start px-4 py-2 text-xs font-bold"><span>Conocer esta línea <span class="ml-1">→</span></span></a></article>)}</div></div></section>

<section id="soluciones" class="bg-[#df9417] px-4 py-12 sm:px-6 lg:px-8 lg:py-16"><div class="mx-auto max-w-7xl space-y-7"><div class="text-center text-white"><p class="text-xs uppercase italic tracking-[0.15em]">QUÉ PODEMOS AYUDARTE A DESARROLLAR</p><h2 class="text-2xl font-bold sm:text-3xl">De una necesidad de capacitación a una experiencia que deja capacidad instalada</h2><p class="mx-auto mt-2 max-w-3xl text-sm italic">Definimos el nivel de formación y conectamos la solución con el formato, la duración, los recursos y el acompañamiento que el equipo realmente necesita.</p></div><div class="grid grid-cols-2 gap-3 md:grid-cols-5">{needs.map((need) => <div class="card-need"><div class="card-icon-circle h-9 w-9" style={`background-color:${need.color}`}><Icon name={need.icon} class="h-5 w-5 text-white stroke-1" /></div><span class="text-[11px] font-bold leading-tight text-[#1a375b]">{need.label}</span></div>)}</div><div class="inline-block rounded-md bg-[#091E3A] px-4 py-2 text-lg font-bold text-white">Soluciones que pueden integrarse</div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{solutions.map((solution) => <article class="card-integration"><Icon name={solution.icon} class="h-12 w-12 shrink-0 text-[#1665c0] stroke-1" /><div><h3 class="text-sm font-bold leading-tight text-[#1a375b]">{solution.title}</h3><p class="mt-1 text-xs leading-snug text-[#1a375b]/80">{solution.desc}</p><a href="/contactanos" class="mt-3 inline-flex rounded-full border border-[#1a375b] px-3 py-1 text-[11px] font-bold text-[#1a375b] hover:bg-[#1a375b] hover:text-white"><span>Conocer la solución →</span></a></div></article>)}</div></div></section>

<section id="metodologia"><div class="bg-[#091E3A] px-4 py-14 text-white sm:px-6 lg:px-8 lg:py-16"><div class="mx-auto max-w-7xl space-y-8"><p class="text-xs uppercase italic tracking-[0.15em] text-[#df9417]">NUESTRA METODOLOGÍA</p><h2 class="text-2xl font-bold sm:text-3xl">La formación empieza antes del aula y continúa después de la sesión.</h2><div class="grid gap-8 md:grid-cols-5">{steps.map((step) => <div class="text-center"><div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white text-[#1665c0]"><Icon name={step.icon} class="h-9 w-9 stroke-1" /></div><h3 class="mt-3 text-sm font-bold">{step.num}.{step.title}</h3><p class="mt-1 text-xs leading-tight text-slate-300">{step.desc}</p></div>)}</div></div></div><div class="bg-white px-4 py-12 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><p class="text-xs uppercase italic tracking-[0.15em] text-[#1a375b]">POR QUÉ CEDEPRO FORMACIÓN</p><h2 class="mt-2 text-2xl font-bold text-[#1a375b] sm:text-3xl">Formación aplicada, pertinente y <span class="text-[#df9417]">preparada para escalar.</span></h2></div></div></section>

<section class="relative overflow-hidden bg-[#07192F] px-4 py-16 text-white sm:px-6 lg:px-8 lg:py-24"><img src="/assets/portafolio/vista-proyectos/img-portafolio-proyectos-section-7.webp" alt="Equipo conversando sobre formación" class="absolute inset-0 h-full w-full object-cover object-right opacity-75" loading="lazy" /><div class="absolute inset-0 bg-[#091E3A]/80"></div><div class="relative z-10 mx-auto max-w-7xl"><div class="max-w-2xl space-y-5"><p class="text-xs uppercase italic tracking-[0.15em]">EXPERIENCIA QUE RESPALDA NUESTRAS DECISIONES</p><h2 class="text-2xl font-bold leading-tight sm:text-3xl">Si quieres fortalecer las capacidades de tu equipo, conversemos.</h2><p class="text-sm leading-relaxed text-slate-200">Diseñamos una ruta formativa conectada con tu institución, tus personas y los resultados que necesitas alcanzar.</p><div class="flex flex-col gap-3 pt-2 sm:flex-row"><a href="/contactanos" class="btn-on-gold inline-flex justify-center px-6 py-3 text-sm font-bold"><span>Solicita una propuesta <span class="ml-1">→</span></span></a><a href="/contactanos" class="btn-outline-white inline-flex justify-center px-6 py-3 text-sm font-bold"><span>Hablemos de tu reto</span></a></div></div></div></section>
