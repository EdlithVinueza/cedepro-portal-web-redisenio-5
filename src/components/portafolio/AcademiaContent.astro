---
import { Icon } from "astro-icon/components";
import HeroResponsiveBackground from "../HeroResponsiveBackground.astro";
import GradientOverlay from "../GradientOverlay.astro";
import CardProfile from "../cards/CardProfile.astro";
import CardNeed from "../cards/CardNeed.astro";
import CardGrid from "../cards/CardGrid.astro";
import CardIntegration from "../cards/CardIntegration.astro";
import MethodologySteps from "../cards/MethodologySteps.astro";
import ReasonsGroup from "../cards/ReasonsGroup.astro";
import CardImageHorizontal from "../cards/CardImageHorizontal.astro";

const reasons = [
  { title: "Aprendizaje conectado al contexto", icon: "ion:school-outline" },
  { title: "Aplicación antes que acumulación", icon: "ion:bar-chart-outline" },
  { title: "Diseño institucional", icon: "ion:shield-checkmark-outline" },
  { title: "Escalabilidad digital", icon: "ion:git-network-outline" },
  { title: "Articulación de capacidades", icon: "ion:heart-outline" },
];

const profiles = [
  {
    title:
      "Rectores, promotores y autoridades que impulsan mejoras institucionales.",
    icon: "ion:business-outline",
    color: "#091E3A",
  },
  {
    title:
      "Equipos administrativos de calidad, bienestar, planificación y gestión institucional.",
    icon: "ion:people-outline",
    color: "#00838f",
  },
  {
    title:
      "Docentes y responsables académicos que necesitan actualizar sus prácticas y recursos.",
    icon: "ion:stats-chart-outline",
    color: "#1665c0",
  },
  {
    title:
      "Instituciones que requieren programas presenciales, virtuales o híbridos.",
    icon: "ion:bulb-outline",
    color: "#5e35b1",
  },
  {
    title:
      "Organizaciones que buscan rutas formativas y microcredenciales para sus equipos.",
    icon: "ion:document-text-outline",
    color: "#df9417",
  },
];

const needs = [
  {
    label: "Tu equipo necesita actualizarse",
    icon: "ion:arrow-up-circle-outline",
    color: "#091E3A",
  },
  {
    label: "Quieres fortalecer la práctica docente",
    icon: "ion:stats-chart-outline",
    color: "#1665c0",
  },
  {
    label: "Necesitas capacitación institucional",
    icon: "ion:document-text-outline",
    color: "#00838f",
  },
  {
    label: "Buscas una ruta más flexible",
    icon: "ion:people-outline",
    color: "#1976d2",
  },
  {
    label: "Quieres que la formación se sostenga",
    icon: "ion:search-outline",
    color: "#5e35b1",
  },
];

const solutions = [
  {
    title: "Capacidades Institucionales",
    desc: "Programas y procesos de aprendizaje para docentes, directivos y equipos que necesitan fortalecer su desempeño y responder a retos institucionales.",
    icon: "ion:settings-outline",
    buttonText: "Fortalecer a mi equipo",
    href: "/contactanos",
  },
  {
    title: "Formación continua y cursos virtuales",
    desc: "Cursos especializados, actualización, microcredenciales y rutas flexibles apoyadas por recursos digitales y experiencias de aprendizaje escalables.",
    icon: "ion:school-outline",
    buttonText: "Explorar formación continua",
    href: "/contactanos",
  },
  {
    title: "Formación territorial y socioeducativa",
    desc: "Procesos de aprendizaje y acompañamiento conectados con comunidades y contextos diversos, con inclusión, género y diversidad como enfoques transversales.",
    icon: "ion:document-text-outline",
    buttonText: "Conocer esta línea",
    href: "/contactanos",
  },
];

const steps = [
  {
    num: "1",
    title: "Comprender",
    desc: "Entendemos necesidades para crear formación efectiva",
    icon: "ion:settings-outline",
  },
  {
    num: "2",
    title: "Diseñar",
    desc: "Construimos programas adaptados a cada desafío",
    icon: "ion:construct-outline",
  },
  {
    num: "3",
    title: "Aplicar",
    desc: "Impulsamos aprendizaje práctico orientado a resultados",
    icon: "ion:document-text-outline",
  },
  {
    num: "4",
    title: "Escalar",
    desc: "Multiplicamos alcance con soluciones digitales innovadoras",
    icon: "ion:bulb-outline",
  },
  {
    num: "5",
    title: "Acompañar",
    desc: "Aseguramos implementación, seguimiento y mejora permanente",
    icon: "ion:people-outline",
  },
];
---

<!-- =========================================================================
1. HERO HEADER SECTION
========================================================================= -->
<section
  id="academia"
  class="hero-section relative bg-[#091E3A] overflow-hidden"
>
  <!-- Capa Responsiva Unificada CEDEPRO (Fondo + Degradado adaptable + Cálculo de contenido) -->
  <HeroResponsiveBackground
    desktopImage="/assets/portafolio/vista-academia/img-portafolio-academia-section-1-der.png"
    mobileImage="/assets/portafolio/vista-academia/img-portafolio-academia-section-1-der.png"
    color="brand"
    desktopImagePosX="left"
    desktopImagePosY="center"
    mobileImagePosX="35%"
    mobileImagePosY="top"
    mobileImageHeight="450px"
    mobileImageOffsetY="120px"
    mobileImageAnchor="bottom"
    desktopDirection="to-l"
    mobileDirection="to-b"
    targetContentSelector=".hero-text-block"
    autoCalculateCoverage={true}
    bufferPx={150}
    fadeSpan={200}
    mobileCoverage={22}
    mobileFadeEnd={58}
    desktopCoverage={35}
    desktopFadeEnd={70}
  />

  <div
    class="hero-content relative max-w-[1536px] w-full mx-auto z-10 px-4 sm:px-6 lg:pl-12 lg:pr-16 xl:pr-24 flex justify-end"
  >
    <div class="hero-text-block space-y-3 sm:space-y-4 text-left text-white">
      <p class="section-eyebrow section-eyebrow--gold">CEDEPRO FORMACIÓN</p>

      <h1
        class="text-white text-3xl sm:text-4xl lg:text-[2.6rem] font-bold !leading-[1.14] tracking-tight drop-shadow-sm"
      >
        El conocimiento que no se aplica no transforma.
      </h1>

      <div class="space-y-3 pt-2">
        <p
          class="text-white text-base sm:text-lg font-bold leading-relaxed max-w-xl text-balance drop-shadow-sm"
        >
          Forma equipos que hagan avanzar a tu institución.
        </p>
        <p
          class="text-slate-100 text-sm sm:text-[15px] font-normal leading-relaxed max-w-xl text-balance drop-shadow-sm"
        >
          Diseñamos experiencias de aprendizaje prácticas, actuales y conectadas
          con los desafíos de la educación superior. Fortalecemos las
          capacidades de docentes, directivos y equipos de trabajo para que lo
          aprendido se convierta en mejores decisiones, mejores prácticas y
          resultados sostenibles.
        </p>
      </div>

      <div
        class="pt-4 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 w-full sm:w-auto"
      >
        <a
          href="#soluciones"
          class="btn-gold shadow-lg w-full sm:w-auto text-center justify-center inline-flex items-center"
        >
          <span
            class="inline-flex items-center justify-center text-center leading-none"
          >
            Conoce nuestra propuesta formativa <span
              class="inline-block ml-1.5 leading-none transition-transform duration-200 hover:translate-x-1 font-bold"
              >→</span
            >
          </span>
        </a>

        <a
          href="/contactanos"
          class="btn-outline-white w-full sm:w-auto text-center justify-center inline-flex items-center"
        >
          <span
            class="inline-flex items-center justify-center text-center leading-none"
          >
            Diseña una ruta para tu equipo
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="bg-white px-4 py-14 text-center sm:px-6 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-7xl space-y-10">
    <div class="mx-auto max-w-4xl space-y-3">
      <p class="section-eyebrow section-eyebrow--blue">
        PARA QUIENES NECESITAN CONVERTIR APRENDIZAJE EN DESEMPEÑO
      </p><h2
        class="text-2xl font-bold leading-tight text-[#1a375b] sm:text-3xl"
      >
        La formación que responde a los <span class="text-[#df9417]"
          >retos reales</span
        > de tu equipo
      </h2><p class="text-[15px] leading-relaxed text-[#1a375b]">
        CEDEPRO Formación está dirigida a instituciones, organizaciones y
        equipos que necesitan actualizar conocimientos, fortalecer competencias
        y mejorar la manera en que trabajan.
      </p>
    </div><CardGrid count={profiles.length}>
      {
        profiles.map((profile) => (
          <CardProfile
            title={profile.title}
            icon={profile.icon}
            color={profile.color}
          />
        ))
      }
    </CardGrid>
  </div>
</section>

<!-- =========================================================================
3. EL RETO Y NUESTRA RESPUESTA (Estructura Asesoría con imagen img-portafolio-academia-section-2-iz.png)
========================================================================= -->
<section
  class="relative bg-[#091E3A] overflow-hidden flex flex-col lg:flex-row lg:items-stretch min-h-[500px]"
>
  <div
    class="w-full lg:w-[30%] xl:w-[25%] relative min-h-[300px] lg:min-h-full"
  >
    <div class="absolute inset-0">
      <img
        src="/assets/portafolio/vista-academia/img-portafolio-academia-section-2-iz.png"
        alt="Docente e instructora en formación CEDEPRO"
        class="w-full h-full object-cover object-[60%_top]"
        decoding="async"
      />
      <GradientOverlay
        color="brand"
        coverage={10}
        desktopDirection="to-l"
        mobileDirection="to-t"
        fadeEnd={90}
      />
    </div>
  </div>

  <div
    class="w-full lg:w-[70%] xl:w-[75%] relative z-10 p-8 sm:p-12 lg:py-16 lg:pr-12 xl:pr-16 flex items-center"
  >
    <div
      class="w-full grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-start"
    >
      <div class="space-y-4">
        <p class="section-eyebrow section-eyebrow--gold">EL RETO</p>
        <h2
          class="text-white text-2xl sm:text-3xl lg:text-4xl font-medium leading-tight tracking-tight"
        >
          Capacitar no es suficiente si el aprendizaje <span
            class="text-[#df9417] font-bold"
            >no cambia la forma de trabajar</span
          >
        </h2>
        <p
          class="text-slate-200 text-sm sm:text-[15px] font-normal leading-relaxed"
        >
          Muchas instituciones invierten en cursos que no se conectan con sus
          problemas, no generan prácticas nuevas o no dejan capacidades
          instaladas. El desafío está en diseñar formación relevante, aplicable
          y conectada con la operación real.
        </p>
        <div class="pt-2">
          <a href="#metodologia" class="btn-gold">
            <span
              class="inline-flex items-center justify-center text-center leading-none transform -translate-y-[1px]"
            >
              Identifica la necesidad de tu equipo <span
                class="inline-block ml-1.5 leading-none">→</span
              >
            </span>
          </a>
        </div>
      </div>

      <div class="space-y-4 md:pl-10 md:border-l md:border-white/20">
        <p class="section-eyebrow section-eyebrow--gold">NUESTRA RESPUESTA</p>
        <h2
          class="text-white text-2xl sm:text-3xl lg:text-4xl font-medium leading-tight tracking-tight"
        >
          Capacidades que se convierten en <span
            class="text-[#df9417] font-bold">resultados</span
          >
        </h2>
        <p
          class="text-slate-200 text-sm sm:text-[15px] font-normal leading-relaxed"
        >
          Partimos de los desafíos y objetivos de la institución para diseñar
          experiencias formativas que combinen contenido actual, práctica,
          acompañamiento y recursos digitales.
        </p>
        <div class="pt-2">
          <div
            class="inline-block bg-white text-[#1a375b] px-5 py-2.5 rounded-full text-sm font-bold shadow-md italic"
          >
            Formación eficaz para capacitar y avanzar.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-white px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-7xl space-y-10">
    <div>
      <p class="section-eyebrow section-eyebrow--blue">
        UNA LÍNEA PARAGUAS TRES FORMAS DE DESARROLLAR CAPACIDADES
      </p>
      <h2 class="text-2xl font-bold text-[#1a375b] sm:text-3xl mt-1">
        Elige el tipo de <span class="text-[#df9417]">aprendizaje</span> que tu reto
        necesita
      </h2>
    </div>

    <CardGrid count={solutions.slice(0, 3).length}>
      {
        solutions
          .slice(0, 3)
          .map((solution) => (
            <CardImageHorizontal
              title={solution.title}
              description={solution.desc}
              icon={solution.icon}
              iconBgColor="#1665c0"
              iconLayout="col"
              buttonText={`${solution.buttonText} →`}
              buttonHref={solution.href}
            />
          ))
      }
    </CardGrid>
  </div>
</section>

<!-- =========================================================================
5. QUÉ PODEMOS AYUDARTE A DESARROLLAR
========================================================================= -->
<section
  id="soluciones"
  class="py-8 sm:py-10 px-4 sm:px-6 lg:px-8 bg-[#df9417] overflow-hidden"
>
  <div class="max-w-[1400px] mx-auto space-y-6">
    <div class="text-center space-y-1.5 w-full mx-auto text-white">
      <p class="section-eyebrow section-eyebrow--white">
        QUÉ PODEMOS AYUDARTE A DESARROLLAR
      </p>
      <h2
        class="text-2xl sm:text-3xl md:text-[2rem] lg:text-[2.2rem] xl:text-[2.4rem] font-bold tracking-tight drop-shadow-sm whitespace-normal lg:whitespace-nowrap"
      >
        De una necesidad de capacitación a una experiencia que deja capacidad
        instalada
      </h2>
      <p
        class="text-white/95 text-[14px] sm:text-[15px] italic leading-relaxed pt-1 max-w-4xl mx-auto"
      >
        Definimos el nivel de formación que corresponde al reto y conectamos la
        solución con el formato, la duración, los recursos y el acompañamiento
        que el equipo realmente necesita.
      </p>
    </div>

    <!-- Fila 1: 5 Necesidades -->
    <CardGrid count={needs.length} maxWidth="64rem">
      {
        needs.map((n, i) => {
          return <CardNeed label={n.label} icon={n.icon} color={n.color} />;
        })
      }
    </CardGrid>

    <!-- Fila 2: Soluciones -->
    <div class="space-y-4 pt-1">
      <div
        class="inline-block bg-[#091E3A] text-white px-5 py-2 rounded-md shadow-md"
      >
        <h3 class="text-lg sm:text-[20px] font-bold">
          Soluciones que pueden integrarse
        </h3>
      </div>

      <CardGrid count={solutions.length}>
        {
          solutions.map((sol, index) => (
            <div class="flex">
              <CardIntegration
                title={sol.title}
                desc={sol.desc}
                icon={sol.icon}
                buttonText={
                  index === 0
                    ? "Diseñar un programa →"
                    : index === 1
                      ? "Explorar cursos →"
                      : index === 2
                        ? "Conocer las rutas →"
                        : "Conocer AWLA →"
                }
                buttonHref="/contactanos"
                class="w-full"
              />
            </div>
          ))
        }
      </CardGrid>
    </div>
  </div>
</section>

<!-- =========================================================================
6. METODOLOGÍA Y POR QUÉ CEDEPRO
========================================================================= -->
<section id="metodologia">
  <!-- PARTE SUPERIOR: METODOLOGÍA (Fondo Azul) -->
  <div class="bg-[#091E3A] py-10 sm:py-12 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="max-w-6xl mx-auto space-y-6">
      <div class="space-y-1 text-left">
        <p
          class="text-[#df9417] text-[12px] lg:text-[14px] font-normal tracking-[0.15em] uppercase"
        >
          NUESTRA METODOLOGÍA
        </p>
        <h2
          class="text-white text-2xl sm:text-3xl lg:text-[2.2rem] font-bold tracking-tight leading-tight"
        >
          <span class="text-[#df9417]">La formación</span> empieza antes del aula
          y continúa después de la sesión.
        </h2>
      </div>

      <MethodologySteps items={steps} theme="dark" />
    </div>
  </div>

  <!-- PARTE INFERIOR: POR QUÉ CEDEPRO FORMACIÓN (Fondo Blanco) -->
  <div class="bg-white py-10 sm:py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-6">
      <div class="space-y-1 text-left">
        <p class="section-eyebrow section-eyebrow--blue">
          POR QUÉ CEDEPRO FORMACIÓN
        </p>
        <h2
          class="text-[#1a375b] text-2xl sm:text-3xl lg:text-[2rem] font-bold tracking-tight"
        >
          Formación aplicada, pertinente y <span class="text-[#df9417]"
            >preparada para escalar.</span
          >
        </h2>
      </div>

      <ReasonsGroup
        items={reasons}
        variant="alternating"
        dividerColorClass="divide-slate-200"
      />
    </div>
  </div>
</section>

<section
  class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 text-white overflow-hidden bg-[#07192F]"
>
  <div class="absolute inset-0 z-0">
    <picture>
      <source
        srcset="/assets/nosotros/img-nosotros-section-9.webp"
        type="image/webp"
      />
      <img
        src="/assets/nosotros/img-nosotros-section-9.webp"
        alt="Consultores trabajando en reunión estratégica nocturna"
        class="w-full h-full object-cover object-right sm:object-center"
        width="1920"
        height="1080"
        decoding="async"
        loading="lazy"
      />
    </picture>
  </div>

  <!-- FILTRO AZUL TRANSLÚCIDO NITIDO (SIN BLUR) -->
  <div class="absolute inset-0 bg-[#091E3A]/70 z-10 pointer-events-none"></div>
  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="max-w-2xl space-y-5">
      <p class="section-eyebrow section-eyebrow--gold">
        EXPERIENCIA QUE RESPALDA NUESTRAS DECISIONES
      </p>
      <h2 class="text-2xl font-bold leading-tight sm:text-3xl">
        Si quieres fortalecer las capacidades de tu equipo, conversemos.
      </h2>
      <p class="text-sm leading-relaxed text-slate-200">
        Diseñamos una ruta formativa conectada con tu institución, tus personas
        y los resultados que necesitas alcanzar.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row">
        <a
          href="/contactanos"
          class="btn-on-gold inline-flex justify-center px-6 py-3 text-sm font-bold"
          ><span>Solicita una propuesta <span class="ml-1">→</span></span></a
        >
        <a
          href="/contactanos"
          class="btn-outline-white inline-flex justify-center px-6 py-3 text-sm font-bold"
          ><span>Hablemos de tu reto</span></a
        >
      </div>
    </div>
  </div>
</section>

<!-- ESTILOS PARA HERO HEADER -->
<style is:global>
  @media (orientation: portrait), (max-aspect-ratio: 1/1), (max-width: 767px) {
    .hero-section {
      min-height: 710px !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      background-color: #091e3a !important;
      padding-top: 1rem !important;
      padding-bottom: 0 !important;
    }
    .hero-content {
      padding-top: 0.5rem !important;
      padding-bottom: 1rem !important;
      z-index: 10 !important;
      justify-content: flex-start !important;
    }
  }

  @media (orientation: landscape) and (min-aspect-ratio: 1/1) and (min-width: 768px) {
    .hero-section {
      min-height: 620px !important;
      max-height: 860px !important;
      height: calc(100vh - 4rem) !important;
      display: flex !important;
      align-items: center !important;
      background-color: #091e3a !important;
      padding: 2.5rem 0 !important;
    }

    .hero-text-block {
      max-width: 450px !important;
    }
    @media (min-width: 1200px) {
      .hero-text-block {
        max-width: 520px !important;
      }
    }
    @media (min-width: 1440px) {
      .hero-text-block {
        max-width: 580px !important;
      }
    }
  }
</style>
