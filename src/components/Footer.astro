---
const currentYear = 2026;
---

<footer
 class="relative bg-[#07192F] text-white border-t border-[#0d2d59] pt-12 sm:pt-14 pb-10 sm:pb-12"
>
 <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
 <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start">
 <!-- Columna 1: Logo CEDEPRO, ¡Encuéntranos!, Redes Sociales y Copyright -->
 <div class="md:col-span-5 lg:col-span-5 space-y-5">
 <a
 href="/"
 class="inline-block transition-transform hover:opacity-95 active:scale-95"
 aria-label="Inicio CEDEPRO"
 >
 <img
 src="/assets/footer/img-footer-logo.webp"
 alt="CEDEPRO Centro de Desarrollo Educativo y Profesional"
 class="max-w-[210px] sm:max-w-[240px] md:max-w-[260px] h-auto object-contain"
 width="260"
 height="68"
 decoding="async"
 loading="lazy"
 />
 </a>

 <div class="space-y-3 pt-1">
 <h4 class="text-white text-base sm:text-lg font-bold tracking-tight">
 ¡Encuéntranos!
 </h4>
